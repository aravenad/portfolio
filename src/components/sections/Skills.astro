---
import ReadMore from "../ui/ReadMore.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import SkillChip from "../ui/SkillChip.astro";
import SkillList from "../ui/SkillList.astro";
import SkillTile from "../ui/SkillTile.astro";
import type { Skill } from "../../types";

interface Props {
  id: string;
  title: string;
  skills: Skill[];
  /** Grille d'icônes (langages, outils) ou liste détaillée. */
  variant?: "grid" | "list";
  /** Place les compétences à gauche et le texte à droite. */
  reverse?: boolean;
}

const { id, title, skills, variant = "grid", reverse = false } = Astro.props;

/*
 * Sur grand écran, deux rangées : le titre seul, puis le texte et les
 * compétences côte à côte. Les tuiles et la liste partent ainsi de la première
 * ligne du texte, pas du haut du titre. Sur téléphone, une seule colonne dans
 * l'ordre du document : titre, texte, compétences.
 */
const textColumn = reverse ? "lg:col-start-2" : "lg:col-start-1";
const skillsColumn = reverse ? "lg:col-start-1" : "lg:col-start-2";
---

<Section id={id} aria-labelledby={`${id}-title`}>
  <div class="grid items-start lg:grid-cols-2 lg:gap-x-20">
    <div class:list={["lg:row-start-1", textColumn]}>
      <SectionHeading headingId={`${id}-title`} title={title} chrome />
    </div>

    <div class:list={["lg:row-start-2", textColumn]}>
      <ReadMore class="mt-6 text-lg leading-8 text-zinc-400">
        <slot />
      </ReadMore>
    </div>

    {/* `lg:mt-6` : la même marge que le texte, posée dans ReadMore. */}
    <div class:list={["mt-12 lg:row-start-2 lg:mt-6", skillsColumn]}>
      {
        variant === "grid" ? (
          <Fragment>
            {/*
              Sur téléphone, vingt tuiles carrées feraient sept rangées (plus
              d'un écran) pour des noms déjà cités dans le texte. Des pastilles
              logo + nom disent la même chose en trois fois moins de hauteur.
            */}
            <ul data-skill-chips class="flex flex-wrap gap-2 sm:hidden">
              {skills.map((skill) => (
                <SkillChip skill={skill} />
              ))}
            </ul>
            {/*
              À côté du texte, la colonne plafonne la grille à 512 px. Entre
              640 et 1023 px, la grille passe sous le texte et prenait toute la
              largeur : des tuiles de 230 px. `max-w-lg` leur garde la taille
              qu'elles ont sur grand écran, et la grille se centre sous le
              texte, qui lui court sur toute la largeur.
            */}
            <ul class="mx-auto hidden max-w-lg grid-cols-4 gap-3 sm:grid">
              {skills.map((skill) => (
                <SkillTile skill={skill} />
              ))}
            </ul>
          </Fragment>
        ) : (
          <SkillList skills={skills} />
        )
      }
    </div>
  </div>
</Section>

<script>
  import { onEachPage } from "../../lib/enhance";

  /*
   * Safari iOS n'applique `:active` qu'aux éléments qui écoutent le toucher :
   * sans cet écouteur vide, appuyer sur une pastille n'allumerait pas son logo.
   */
  onEachPage((signal) => {
    document.querySelector("[data-skill-chips]")?.addEventListener("touchstart", () => {}, {
      passive: true,
      signal,
    });
  });
</script>
