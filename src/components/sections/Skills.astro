---
import ReadMore from "../ui/ReadMore.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import SkillChip from "../ui/SkillChip.astro";
import SkillList from "../ui/SkillList.astro";
import SkillTile from "../ui/SkillTile.astro";
import type { Skill } from "../../types";

interface Props {
  id: string;
  title: string;
  skills: Skill[];
  /** Grille d'icônes (langages, outils) ou liste détaillée. */
  variant?: "grid" | "list";
  /** Place les compétences à gauche et le texte à droite. */
  reverse?: boolean;
}

const { id, title, skills, variant = "grid", reverse = false } = Astro.props;
---

<Section id={id} aria-labelledby={`${id}-title`}>
  <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
    <div class:list={[reverse && "lg:order-2"]}>
      <SectionHeading headingId={`${id}-title`} title={title} chrome />

      <ReadMore class="mt-6 text-lg leading-8 text-zinc-400">
        <slot />
      </ReadMore>
    </div>

    <div class:list={[reverse && "lg:order-1"]}>
      {
        variant === "grid" ? (
          <Fragment>
            {/*
              Sur téléphone, seize tuiles carrées faisaient six rangées (près
              d'un écran) pour des noms déjà cités dans le texte. Des pastilles
              logo + nom disent la même chose en trois fois moins de hauteur.
            */}
            <ul data-skill-chips class="flex flex-wrap gap-2 sm:hidden">
              {skills.map((skill) => (
                <SkillChip skill={skill} />
              ))}
            </ul>
            <div class="hidden grid-cols-4 gap-3 sm:grid">
              {skills.map((skill) => (
                <SkillTile skill={skill} />
              ))}
            </div>
          </Fragment>
        ) : (
          <SkillList skills={skills} />
        )
      }
    </div>
  </div>
</Section>

<script>
  import { onEachPage } from "../../lib/enhance";

  /*
   * Safari iOS n'applique `:active` qu'aux éléments qui écoutent le toucher :
   * sans cet écouteur vide, appuyer sur une pastille n'allumerait pas son logo.
   */
  onEachPage((signal) => {
    document.querySelector("[data-skill-chips]")?.addEventListener("touchstart", () => {}, {
      passive: true,
      signal,
    });
  });
</script>
