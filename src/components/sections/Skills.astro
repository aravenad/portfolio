---
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import SkillList from "../ui/SkillList.astro";
import SkillTile from "../ui/SkillTile.astro";
import type { Skill } from "../../types";

interface Props {
  id: string;
  title: string;
  skills: Skill[];
  /** Grille d'icônes (langages, outils) ou liste détaillée. */
  variant?: "grid" | "list";
  /** Place les compétences à gauche et le texte à droite. */
  reverse?: boolean;
}

const { id, title, skills, variant = "grid", reverse = false } = Astro.props;
---

<Section id={id} aria-labelledby={`${id}-title`}>
  <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
    <div class:list={[reverse && "lg:order-2"]}>
      <SectionHeading headingId={`${id}-title`} title={title} chrome />

      <div class="mt-6 space-y-4 text-lg leading-8 text-zinc-400">
        <slot />
      </div>
    </div>

    <div class:list={[reverse && "lg:order-1"]}>
      {
        variant === "grid" ? (
          <div class="grid grid-cols-3 gap-3 sm:grid-cols-4">
            {skills.map((skill) => (
              <SkillTile skill={skill} />
            ))}
          </div>
        ) : (
          <SkillList skills={skills} />
        )
      }
    </div>
  </div>
</Section>
