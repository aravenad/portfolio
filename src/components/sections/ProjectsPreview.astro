---
import ProjectCard from "../ProjectCard.astro";
import Arrow from "../ui/Arrow.astro";
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { useTranslations } from "../../data/ui";
import { getLang, localizedUrl } from "../../lib/i18n";
import { getFeaturedProjects, getProjects } from "../../lib/projects";

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
const projects = await getProjects(lang);
const featuredProjects = await getFeaturedProjects(3, lang);
---

<Section id="projects" aria-labelledby="projects-title">
  <SectionHeading
    headingId="projects-title"
    title={t.projects.previewTitle}
    chrome
    description={t.projects.previewDescription}
  />

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {featuredProjects.map((project) => <ProjectCard project={project} showTags={false} />)}
  </div>

  {
    projects.length > featuredProjects.length && (
      <div class="mt-12">
        <Button href={localizedUrl("/projects", lang)} variant="secondary" class="group gap-2">
          {t.projects.seeAll}
          <Arrow class="transition group-hover:translate-x-1" />
        </Button>
      </div>
    )
  }
</Section>
