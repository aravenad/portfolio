---
import ProjectCard from "../ProjectCard.astro";
import Arrow from "../ui/Arrow.astro";
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { getFeaturedProjects, getProjects } from "../../lib/projects";
import { url } from "../../lib/url";

const projects = await getProjects();
const featuredProjects = await getFeaturedProjects(3);
---

<Section id="projects" aria-labelledby="projects-title">
  <SectionHeading
    headingId="projects-title"
    title="Mes projets"
    chrome
    description="Ces compétences se retrouvent dans les projets menés durant ma formation."
  />

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {featuredProjects.map((project) => <ProjectCard project={project} showTags={false} />)}
  </div>

  {
    projects.length > featuredProjects.length && (
      <div class="mt-12">
        <Button href={url("/projects")} variant="secondary" class="group gap-2">
          Voir tous les projets
          <Arrow class="transition group-hover:translate-x-1" />
        </Button>
      </div>
    )
  }
</Section>
