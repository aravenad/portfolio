---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Props {
  /** Texte précédant le prénom mis en couleur. */
  intro: string;
  name: string;
  description: string;
}

const { intro, name, description } = Astro.props;
---

<section class="flex min-h-[calc(100svh-4rem)] flex-col justify-center py-24 sm:py-32">
  <Container>
    <h1 class="max-w-4xl text-5xl font-bold tracking-tight sm:text-7xl">
      {intro} <span class="text-chrome">{name}</span>.
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
      {description}
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="#projects">Voir mes projets</Button>
      <Button href="#contact" variant="secondary">Me contacter</Button>
    </div>
  </Container>
</section>

<script>
  /**
   * Met le reflet du prénom en pause dès qu'il quitte l'écran.
   *
   * L'animation porte sur une `background-position` découpée par le texte : elle
   * n'est pas composée par le GPU et repeint à chaque image. Mesuré sur le build,
   * elle coûte ~9 % du fil principal — et autant une fois le hero défilé hors de
   * vue, puisqu'une animation CSS ne s'arrête pas d'elle-même. Une page laissée
   * ouverte consommerait indéfiniment pour un effet que personne ne regarde.
   *
   * Sous `prefers-reduced-motion`, il n'y a aucune animation à mettre en pause :
   * la propriété est alors posée dans le vide, sans effet ni coût.
   */
  const shine = document.querySelector<HTMLElement>(".text-chrome");

  if (shine && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(([entry]) => {
      shine.style.animationPlayState = entry.isIntersecting ? "running" : "paused";
    });

    observer.observe(shine);
  }
</script>
