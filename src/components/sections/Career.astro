---
import CareerItem from "../ui/CareerItem.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { education, educationEn, experiences, experiencesEn } from "../../data/career";
import { useTranslations } from "../../data/ui";
import { getLang, localized } from "../../lib/i18n";

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
const career = localized(lang, {
  fr: { experiences, education },
  en: { experiences: experiencesEn, education: educationEn },
});
---

<Section id="career" aria-labelledby="career-title">
  <SectionHeading
    headingId="career-title"
    title={t.career.title}
    chrome
    description={t.career.description}
  />

  <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-20">
    <div>
      <h3
        class="text-xs font-semibold uppercase tracking-widest text-zinc-500"
      >
        {t.career.experience}
      </h3>

      <ul class="mt-4 border-t border-zinc-900">
        {career.experiences.map((entry) => <CareerItem entry={entry} />)}
      </ul>
    </div>

    <div>
      <h3
        class="text-xs font-semibold uppercase tracking-widest text-zinc-500"
      >
        {t.career.education}
      </h3>

      <ul class="mt-4 border-t border-zinc-900">
        {career.education.map((entry) => <CareerItem entry={entry} />)}
      </ul>
    </div>
  </div>
</Section>
