---
import CareerItem from "../ui/CareerItem.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { education, experiences } from "../../data/career";
---

<Section id="career" aria-labelledby="career-title">
  <SectionHeading
    headingId="career-title"
    title="Parcours"
    chrome
    description="Ma formation et les expériences qui m'ont fait découvrir le métier."
  />

  <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-20">
    <div>
      <h3
        class="text-xs font-semibold uppercase tracking-widest text-zinc-500"
      >
        Expérience
      </h3>

      <ul class="mt-4 border-t border-zinc-900">
        {experiences.map((entry) => <CareerItem entry={entry} />)}
      </ul>
    </div>

    <div>
      <h3
        class="text-xs font-semibold uppercase tracking-widest text-zinc-500"
      >
        Formation
      </h3>

      <ul class="mt-4 border-t border-zinc-900">
        {education.map((entry) => <CareerItem entry={entry} />)}
      </ul>
    </div>
  </div>
</Section>
