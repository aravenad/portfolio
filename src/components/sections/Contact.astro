---
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { site } from "../../data/site";
---

<Section id="contact" aria-labelledby="contact-title">
  <SectionHeading
    headingId="contact-title"
    title="Me contacter"
    description="Je recherche un stage de 10 à 12 semaines à partir de début avril 2027, pour valider ma deuxième année de BUT Informatique. Une question, une opportunité ? Écris-moi."
  />

  <div class="mt-12 flex flex-wrap gap-4">
    <Button href={`mailto:${site.email}`}>Envoyer un e-mail</Button>
    <Button href={site.github} variant="secondary" rel="noreferrer">
      Voir mon GitHub
    </Button>
  </div>
</Section>
