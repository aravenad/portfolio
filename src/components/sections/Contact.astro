---
import Button from "../ui/Button.astro";
import GlyphLogo from "../ui/GlyphLogo.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { outlineButton } from "../ui/button-styles";
import { site } from "../../data/site";
import { useTranslations } from "../../data/ui";
import { publicCv } from "../../lib/cv";
import { brandStyle } from "../../lib/skills";
import { getLang } from "../../lib/i18n";

const t = useTranslations(getLang(Astro.url.pathname));
/** Le CV public, et lui seul : voir src/lib/cv.ts. */
const cv = publicCv();

/*
 * Deux actions, puis deux profils. L'e-mail et le CV gardent des boutons à
 * libellé : ce sont eux qu'un recruteur vient chercher. LinkedIn et GitHub
 * passent en icônes, que tout le monde reconnaît : quatre boutons à libellé
 * alourdissaient la ligne. Leur nom reste dans `aria-label`, et dans `title`
 * pour qui survole.
 *
 * Comme les tuiles de compétences, leur logo est tramé en glyphes et prend la
 * couleur de sa marque au survol. En sombre, le bleu du mode sombre de LinkedIn
 * et le blanc de GitHub : en glyphes, le bleu officiel éteignait le « in ». En
 * clair, leurs couleurs officielles (comme GitHub dans data/skills.ts).
 */
const profiles = [
  {
    href: site.linkedin,
    label: t.contact.linkedin,
    icon: "simple-icons:linkedin",
    brand: brandStyle({ label: "LinkedIn", color: "#70B5F9", colorLight: "#0A66C2" }),
  },
  {
    href: site.github,
    label: t.contact.github,
    icon: "simple-icons:github",
    brand: brandStyle({ label: "GitHub", color: "#FFFFFF", colorLight: "#181717" }),
  },
];
---

<Section id="contact" aria-labelledby="contact-title">
  <SectionHeading
    headingId="contact-title"
    title={t.contact.title}
    chrome
    description={t.contact.description}
  />

  {/*
    Sur téléphone, les deux boutons à libellé prennent la largeur, l'un sous
    l'autre, et les icônes restent ensemble sur leur propre ligne : laissées au
    flux, elles se répartissaient au hasard entre deux rangées.
  */}
  <div class="mt-12 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
    <Button href={`mailto:${site.email}`}>{t.contact.email}</Button>

    <Button href={cv.href} download={cv.filename} variant="secondary">
      {t.contact.cv}
    </Button>

    <div class="flex items-center gap-3 sm:gap-4">
      <span aria-hidden="true" class="mx-1 hidden h-8 w-px bg-zinc-800 sm:block"></span>

      {
        profiles.map((profile) => (
          <a
            href={profile.href}
            rel="noreferrer"
            aria-label={profile.label}
            title={profile.label}
            style={profile.brand}
            data-glyph-hote
            class:list={[
              "inline-flex size-12 items-center justify-center rounded-lg text-zinc-300 transition hover:text-zinc-100",
              outlineButton,
            ]}
          >
            <GlyphLogo name={profile.icon} box="size-10" class="size-5" />
          </a>
        ))
      }
    </div>
  </div>
</Section>
