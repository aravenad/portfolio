---
import Arrow from "./ui/Arrow.astro";
import Badge from "./ui/Badge.astro";
import Card from "./ui/Card.astro";
import { statusLabels, type Project } from "../lib/projects";

interface Props {
  project: Project;
  /** Masqué sur l'aperçu de l'accueil, affiché sur la liste des projets. */
  showTags?: boolean;
}

const { project, showTags = true } = Astro.props;
const { title, summary, tags, status } = project.data;
---

<Card href={`/projects/${project.id}`} class="flex h-full flex-col p-6">
  <h3 class="font-medium text-zinc-100 transition group-hover:text-white">
    {title}
  </h3>

  <p class="mt-3 text-sm leading-6 text-zinc-400">{summary}</p>

  {
    showTags && tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <Badge>{tag}</Badge>
        ))}
      </div>
    )
  }

  <div class="mt-auto flex items-center justify-between gap-4 pt-6">
    <span
      class="flex items-center gap-2 text-sm text-zinc-500 transition group-hover:text-accent"
    >
      Découvrir le projet
      <Arrow class="transition group-hover:translate-x-1" />
    </span>

    <span
      class:list={[
        "shrink-0 text-xs",
        status === "en-cours" ? "text-accent/80" : "text-zinc-600",
      ]}
    >
      {statusLabels[status]}
    </span>
  </div>
</Card>
