---
import ProjectCover from "./ProjectCover.astro";
import Arrow from "./ui/Arrow.astro";
import Badge from "./ui/Badge.astro";
import Card from "./ui/Card.astro";
import { useTranslations } from "../data/ui";
import { getLang } from "../lib/i18n";
import { getProjectHref, type Project } from "../lib/projects";

interface Props {
  project: Project;
  /** Masqué sur l'aperçu de l'accueil, affiché sur la liste des projets. */
  showTags?: boolean;
}

const { project, showTags = true } = Astro.props;
const { title, summary, tags, status, cover } = project.data;
const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
---

{/*
  Sur téléphone, la carte passe en ligne : vignette à gauche, titre et résumé à
  droite, sans étiquettes ni pied. Empilées en grand, six cartes faisaient plus
  de trois écrans avant la pagination ; la fiche du projet garde tout le détail.
*/}
<Card
  href={getProjectHref(project, lang)}
  class="flex h-full flex-row overflow-hidden sm:flex-col"
>
  <ProjectCover
    cover={cover}
    class="w-28 shrink-0 border-r sm:aspect-[16/9] sm:w-auto sm:border-r-0 sm:border-b"
  />

  <div class="flex min-w-0 flex-1 flex-col p-4 sm:p-6">
    <h3 class="font-medium text-zinc-100 transition group-hover:text-white">
      {title}
    </h3>

    <p class="mt-1.5 line-clamp-3 text-sm leading-6 text-zinc-400 sm:mt-3 sm:line-clamp-none">
      {summary}
    </p>

    {
      showTags && tags.length > 0 && (
        <div class="mt-4 hidden flex-wrap gap-2 sm:flex">
          {tags.map((tag) => (
            <Badge>{tag}</Badge>
          ))}
        </div>
      )
    }

    <div class="mt-auto hidden items-center justify-between gap-4 pt-6 sm:flex">
      <span
        class="flex items-center gap-2 text-sm text-zinc-500 transition group-hover:text-accent"
      >
        {t.projects.discover}
        <Arrow class="transition group-hover:translate-x-1" />
      </span>

      <span
        class:list={[
          "shrink-0 text-xs",
          status === "en-cours" ? "text-accent/80" : "text-zinc-600",
        ]}
      >
        {t.projects.status[status]}
      </span>
    </div>
  </div>
</Card>
