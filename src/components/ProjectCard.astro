---
import ProjectCover from "./ProjectCover.astro";
import Arrow from "./ui/Arrow.astro";
import Badge from "./ui/Badge.astro";
import Card from "./ui/Card.astro";
import { useTranslations } from "../data/ui";
import { getLang } from "../lib/i18n";
import { getProjectHref, type Project } from "../lib/projects";

interface Props {
  project: Project;
  /** Masqué sur l'aperçu de l'accueil, affiché sur la liste des projets. */
  showTags?: boolean;
  /**
   * Niveau du titre de la carte : h3 sous le h2 « Mes projets » de l'accueil,
   * h2 directement sous le h1 de la page Projets (RGAA 9.1, sans saut).
   */
  headingLevel?: 2 | 3;
}

const { project, showTags = true, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const { title, summary, teaser, tags, kind, status, cover } = project.data;
const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
// Le statut se lit en pied de carte en grand, sur la ligne du type sur
// téléphone : la même couleur aux deux endroits.
const statusClass = status === "en-cours" ? "text-accent/80" : "text-zinc-500";
---

{/*
  Sur téléphone, la carte passe en ligne : vignette à gauche, titre et résumé à
  droite, sans étiquettes ni pied. Empilées en grand, six cartes faisaient plus
  de trois écrans avant la pagination ; la fiche du projet garde tout le détail.
  Le type et le statut y restent, sur une ligne au-dessus du titre : sans eux,
  un projet en cours ne se distinguait plus d'un projet terminé.
*/}
<Card
  href={getProjectHref(project, lang)}
  class="flex h-full flex-row overflow-hidden sm:flex-col"
>
  <ProjectCover
    cover={cover}
    class="w-28 shrink-0 border-r sm:aspect-[16/9] sm:w-auto sm:border-r-0 sm:border-b"
  />

  <div class="flex min-w-0 flex-1 flex-col p-4 sm:p-6">
    {/*
      Le type du projet, au-dessus du titre ; sur téléphone, suivi du statut.
      Une espace insécable tient le point au type : si la ligne ne tient pas
      (« Application de bureau » à 360 px), elle se coupe après lui, et le
      statut ne commence pas sa ligne par un point.
    */}
    <p class="mb-1 text-xs text-zinc-500 sm:mb-2">
      {t.projects.kinds[kind]}
      <span class="sm:hidden">
        {"\u00A0"}<span aria-hidden="true">·</span>{" "}
        <span class={statusClass} data-card-status>{t.projects.status[status]}</span>
      </span>
    </p>

    <Heading class="font-medium text-zinc-100 transition group-hover:text-white">
      {title}
    </Heading>

    {/* Sur téléphone, le résumé court quand la fiche en a un ; sinon le résumé, coupé. */}
    {
      teaser && (
        <p class="mt-1.5 text-sm leading-6 text-zinc-400 sm:hidden" data-card-teaser>
          {teaser}
        </p>
      )
    }
    <p
      class:list={[
        "mt-1.5 text-sm leading-6 text-zinc-400 sm:mt-3 sm:block sm:line-clamp-none",
        teaser ? "hidden" : "line-clamp-3",
      ]}
    >
      {summary}
    </p>

    {
      showTags && tags.length > 0 && (
        <ul class="mt-4 hidden flex-wrap gap-2 sm:flex">
          {tags.map((tag) => (
            <li>
              <Badge>{tag}</Badge>
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-auto hidden items-center justify-between gap-4 pt-6 sm:flex">
      <span
        class="flex items-center gap-2 text-sm text-zinc-500 transition group-hover:text-accent"
      >
        {t.projects.discover}
        <Arrow class="transition group-hover:translate-x-1" />
      </span>

      <span class:list={["shrink-0 text-xs", statusClass]}>
        {t.projects.status[status]}
      </span>
    </div>
  </div>
</Card>
