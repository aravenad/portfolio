---
import type { MarkdownHeading } from "astro";
import { useTranslations } from "../../data/ui";
import { getLang } from "../../lib/i18n";
import { getTocEntries } from "../../lib/toc";
import TocList from "./TocList.astro";

interface Props {
  /** Titres du Markdown rendu, dans l'ordre du document. */
  headings: MarkdownHeading[];
  class?: string;
}

const { headings, class: className } = Astro.props;

const entries = getTocEntries(headings);
const t = useTranslations(getLang(Astro.url.pathname));

/*
 * Le titre est aligné sur les entrées de premier niveau, en retrait du bord du
 * bloc comme elles.
 */
const title = "pl-4 text-sm font-semibold text-zinc-100";
---

{
  /*
   * Une seule entrée n'est pas un sommaire : elle n'offre aucun choix et répète
   * un titre déjà visible. Mieux vaut alors ne rien afficher.
   */
  entries.length > 1 && (
    <div
      class:list={[
        /*
         * ⚠️ `lg:self-start` fait partie du collant, ce n'est pas un réglage
         * d'alignement. Ce bloc est une cellule de grille, et une cellule est
         * étirée par défaut : il prenait toute la hauteur de la colonne de
         * texte, or un élément aussi haut que son bloc conteneur n'a aucune
         * course — il ne peut donc jamais coller. Ramené à la hauteur de son
         * contenu, il retrouve la place de glisser. Le retirer ne casse rien de
         * visible : le sommaire reste au bon endroit, il défile simplement avec
         * le texte.
         */
        "lg:sticky lg:top-24 lg:self-start",
        className,
      ]}
    >
      {/*
        ⚠️ DEUX RENDUS, ET C'EST VOULU. Sous `lg` le sommaire est replié : une
        fiche fournie en compte huit entrées, qui repousseraient le premier
        paragraphe sous la ligne de flottaison. Dans la colonne de droite, au
        contraire, il doit rester ouvert — c'est tout son intérêt.

        Un `<details>` ne peut pas être rouvert de force en CSS. `open` est un
        attribut, pas une propriété de style, et la seule prise CSS existante
        (`::details-content`) n'est pas encore comprise partout : un navigateur
        qui l'ignore masquerait le sommaire sur grand écran, exactement là où on
        veut le voir. Le déplier au chargement en JavaScript le ferait clignoter
        et le perdrait si le script n'arrive pas.

        Restent deux formes, dont une seule est rendue à la fois. `display: none`
        les retire aussi de l'arbre d'accessibilité : un lecteur d'écran n'en
        rencontre jamais deux. Leur contenu, lui, vient d'un seul `TocList` —
        rien à maintenir en double.
      */}
      <nav data-toc="compact" aria-label={t.toc.title} class="lg:hidden">
        {/*
          Deux filets plutôt qu'une carte : c'est déjà la façon dont la fiche
          sépare ses parties — sous l'en-tête, au-dessus des projets voisins —
          et un encadré ferait du sommaire un objet à part sur la page. Celui du
          haut est le filet de l'en-tête, contre lequel le sommaire se loge ;
          il n'en pose donc qu'un, en dessous.
        */}
        <details data-toc-details class="border-b border-zinc-900 py-3">
          <summary
            class:list={[
              title,
              "flex cursor-pointer list-none items-center justify-between gap-4 transition hover:text-white",
            ]}
          >
            {t.toc.title}
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="toc-chevron size-3.5 shrink-0 text-zinc-600 transition"
            >
              <path d="m3.5 6 4.5 4.5L12.5 6" />
            </svg>
          </summary>

          <TocList entries={entries} class="mt-2 max-h-[45vh]" />
        </details>
      </nav>

      <nav data-toc="sidebar" aria-labelledby="toc-title" class="hidden lg:block">
        <p id="toc-title" class:list={[title]}>{t.toc.title}</p>

        {/*
          La liste défile à part du titre, qui reste visible. Le plafond n'entre
          en jeu qu'une fois la fiche bien fournie, mais un sommaire qui
          dépasserait de la fenêtre serait pire que pas de sommaire du tout.
        */}
        <TocList entries={entries} class="mt-2 max-h-[calc(100vh-10rem)]" />
      </nav>
    </div>
  )
}

<style>
  /* Le triangle natif du navigateur, remplacé par le chevron. */
  summary::-webkit-details-marker {
    display: none;
  }

  [open] > summary .toc-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  import { onEachPage } from "../../lib/enhance";
  import {
    activeHeadingIndex,
    anchorFromHash,
    groupByAnchor,
    readingLine,
  } from "../../lib/toc";

  /**
   * Surligne l'entrée de la dernière section commencée, ou celle qu'on vient
   * de choisir dans le sommaire.
   *
   * Les règles sont dans src/lib/toc.ts, où elles sont testées ; il ne reste ici
   * que les mesures du navigateur.
   *
   * ⚠️ Les deux formes du sommaire sont dans le document, donc CHAQUE titre est
   * visé par deux liens. Les parcourir à plat casserait le surlignage : les
   * hauts de titres ne seraient plus croissants, et « le dernier passé sous la
   * ligne » désignerait n'importe quoi. D'où le regroupement par ancre, qui
   * rend un titre par section, dans l'ordre du document, et allume les deux
   * liens d'un coup, puisqu'on ne sait pas lequel est affiché.
   *
   * `aria-current="location"` porte l'état pour le style et pour les lecteurs
   * d'écran à la fois ; « location » plutôt que « page » car la fiche entière
   * est la page : seule la position dans le document change.
   *
   * Sans JavaScript, seul le surlignage manque : les entrées du sommaire sont
   * de simples ancres et continuent de mener où il faut.
   */
  onEachPage((signal) => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];

    const sections = [
      ...groupByAnchor(links, (link) => anchorFromHash(link.hash)),
    ]
      .map(([anchor, group]) => ({
        anchor,
        heading: document.getElementById(anchor),
        links: group,
      }))
      .filter(
        (
          section,
        ): section is { anchor: string; heading: HTMLElement; links: HTMLAnchorElement[] } =>
          section.heading !== null,
      );

    if (sections.length === 0) return;

    /*
     * L'entrée choisie dans le sommaire, tenue jusqu'à ce que le lecteur
     * reprenne le défilement lui-même.
     *
     * ⚠️ SANS ELLE, LE CLIC ALLUME SOUVENT UNE AUTRE ENTRÉE. La règle de
     * franchissement ne sait pas qu'on a visé un titre : elle prend le dernier
     * passé sous la ligne de lecture. Deux cas la trompent, mesurés sur la fiche
     * du site web :
     *
     * - un `h2` suivi aussitôt d'un `h3` : le saut pose le `h2` en haut, le `h3`
     *   passe la ligne avec lui, et c'est lui qui s'allume ;
     * - les dernières sections : la page ne peut plus défiler assez, la ligne
     *   descend (`readingLine`) et rattrape le titre suivant.
     *
     * Le saut est lui-même un défilement, doux qui plus est : les évènements
     * `scroll` ne disent pas qui défile. Un délai de silence pour dater la fin
     * du saut a été essayé puis écarté : Chrome marque déjà une pause de 85 ms
     * avant de démarrer, et une machine chargée dépassait le délai, si bien que
     * le saut relâchait sa propre entrée. Ce sont donc les gestes du lecteur
     * qui la relâchent (molette, toucher, clavier, clic), qu'un saut d'ancre
     * n'émet jamais.
     *
     * Le clic sur une entrée commence par un `pointerdown`, et la touche Entrée
     * par un `keydown` : tous deux relâchent l'entrée précédente avant que le
     * `click` ne tienne la nouvelle.
     *
     * Reste la barre de défilement, qu'on peut tirer sans émettre aucun de ces
     * gestes (Firefox). Une fois le saut terminé (`scrollend`), l'entrée est
     * aussi relâchée dès que son titre quitte l'écran.
     */
    let pinned: string | null = null;
    let landed = false;

    const pinnedHeading = () =>
      sections.find(({ anchor }) => anchor === pinned)?.heading ?? null;

    const update = () => {
      let active = sections.findIndex(({ anchor }) => anchor === pinned);

      if (active === -1) {
        const viewport = window.innerHeight;
        const remaining =
          document.documentElement.scrollHeight - viewport - window.scrollY;
        const tops = sections.map(({ heading }) => heading.getBoundingClientRect().top);

        active = activeHeadingIndex(tops, readingLine(viewport, remaining), viewport);
      }

      for (const [index, section] of sections.entries()) {
        for (const link of section.links) {
          if (index === active) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      }
    };

    const hold = (anchor: string) => {
      if (!sections.some((section) => section.anchor === anchor)) return;

      pinned = anchor;
      landed = false;
      update();
    };

    const release = () => {
      if (pinned === null) return;

      pinned = null;
      update();
    };

    /*
     * L'ancre est tenue dès le clic, avant que le navigateur ne lance le saut.
     * `hashchange` couvre l'autre chemin vers un titre : les flèches précédent
     * et suivant du navigateur.
     */
    for (const link of links) {
      link.addEventListener("click", () => hold(anchorFromHash(link.hash)), { signal });
    }

    window.addEventListener("hashchange", () => hold(anchorFromHash(location.hash)), {
      signal,
    });

    for (const gesture of ["wheel", "touchstart", "keydown", "pointerdown"]) {
      window.addEventListener(gesture, release, { capture: true, passive: true, signal });
    }

    window.addEventListener(
      "scrollend",
      () => {
        if (pinned !== null) landed = true;
      },
      { signal },
    );

    /*
     * Une fiche ouverte sur une ancre (lien partagé, rechargement) : le
     * navigateur y a sauté, avec les mêmes pièges qu'au clic. Seulement si le
     * titre est à l'écran, toutefois : un rechargement rend la position de
     * lecture, qui peut être bien plus bas que l'ancre restée dans l'adresse.
     */
    const initial = location.hash && document.getElementById(anchorFromHash(location.hash));

    if (initial) {
      const { top } = initial.getBoundingClientRect();

      if (top >= 0 && top < window.innerHeight) {
        pinned = initial.id;
        landed = true;
      }
    }

    update();
    window.addEventListener(
      "scroll",
      () => {
        const heading = pinnedHeading();

        if (heading && landed) {
          const { top, bottom } = heading.getBoundingClientRect();

          if (bottom < 0 || top > window.innerHeight) pinned = null;
        }

        update();
      },
      { passive: true, signal },
    );
    window.addEventListener("resize", update, { signal });
  });

  /**
   * Referme le sommaire replié dès qu'on y choisit une section.
   *
   * Sans cela, il resterait déployé au-dessus du titre visé et occuperait le
   * tiers de l'écran dont on vient de se servir pour en sortir. Le menu du
   * header se referme pour la même raison.
   *
   * Le repli a lieu avant que le navigateur ne calcule le saut d'ancre : la
   * page raccourcit d'abord, la position visée est mesurée ensuite.
   */
  onEachPage((signal) => {
    const details = document.querySelector<HTMLDetailsElement>("[data-toc-details]");

    if (!details) return;

    for (const link of details.querySelectorAll("a")) {
      link.addEventListener("click", () => details.removeAttribute("open"), { signal });
    }
  });
</script>
