---
import { url } from "../../lib/url";

interface Crumb {
  label: string;
  /** Absent pour le dernier niveau : la page courante. */
  href?: string;
}

interface Props {
  /** Niveaux à afficher après l'accueil, du plus général au plus précis. */
  items: Crumb[];
}

const { items } = Astro.props;
const crumbs: Crumb[] = [{ label: "Accueil", href: "/" }, ...items];
---

<nav aria-label="Fil d'Ariane" class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-zinc-500">
    {
      crumbs.map((crumb, index) => (
        <li class="crumb flex items-center gap-x-2" style={`--index: ${index}`}>
          {index > 0 && (
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="size-3.5 text-zinc-700"
            >
              <path d="m6 3.5 4.5 4.5L6 12.5" />
            </svg>
          )}

          {crumb.href ? (
            <a href={url(crumb.href)} class="transition hover:text-zinc-200">
              {crumb.label}
            </a>
          ) : (
            <span aria-current="page" class="text-zinc-300">
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /*
   * Entrée en cascade, transposée de Breadcrumb (smoothui.dev) : chaque niveau
   * arrive décalé de 4 px vers la gauche, à 40 ms d'intervalle. Le composant
   * d'origine est du React piloté par `motion` ; ici rien ne dépend de l'état,
   * donc une animation CSS suffit et n'embarque aucun JS.
   *
   * Le ressort `bounce: 0.1` de l'original est approché par une courbe à léger
   * dépassement : à 0,25 s et sur 4 px, la différence n'est pas perceptible.
   */
  @media (prefers-reduced-motion: no-preference) {
    .crumb {
      animation: crumb-in 0.25s cubic-bezier(0.34, 1.12, 0.64, 1) both;
      animation-delay: calc(var(--index) * 40ms);
    }
  }

  @keyframes crumb-in {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
