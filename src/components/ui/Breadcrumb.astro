---
import Chevron from "./Chevron.astro";
import { useTranslations } from "../../data/ui";
import { getLang, localizedUrl } from "../../lib/i18n";

interface Crumb {
  label: string;
  /** Absent pour le dernier niveau : la page courante. */
  href?: string;
}

interface Props {
  /**
   * Niveaux à afficher après l'accueil, du plus général au plus précis. Les
   * `href` sont neutres : la langue de la page y est ajoutée.
   */
  items: Crumb[];
}

const { items } = Astro.props;
const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
const crumbs: Crumb[] = [{ label: t.breadcrumb.home, href: "/" }, ...items];
---

<nav aria-label={t.breadcrumb.label} data-breadcrumb class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-zinc-500">
    {
      crumbs.map((crumb, index) => (
        <li class="crumb flex items-center gap-x-2" style={`--index: ${index}`}>
          {index > 0 && <Chevron />}

          {crumb.href ? (
            <a href={localizedUrl(crumb.href, lang)} class="transition hover:text-zinc-200">
              {crumb.label}
            </a>
          ) : (
            <span aria-current="page" class="text-zinc-300">
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

{/*
  Le même fil, tel que la barre l'affiche une fois celui-ci défilé sous elle
  (voir Header.astro). Le header persiste d'une page à l'autre et ne se rend
  donc qu'une fois : c'est à chaque page de lui fournir son fil, qu'il recopie.

  L'accueil n'y figure pas : le nom du site, juste avant, en tient lieu. Ni
  `<nav>` ni `aria-current` : le fil de la page reste le seul que les lecteurs
  d'écran annoncent comme tel. Sous 1024 px, la place manque à côté des liens :
  il ne reste que le dernier niveau, qui remplace le nom du site : sans chevron
  devant, et du poids du nom.
*/}
<template data-trail-source>
  <ol class="flex min-w-0 items-center gap-x-2 text-sm text-zinc-500 lg:pr-4 lg:pl-2">
    {
      items.map((crumb, index) => {
        const last = index === items.length - 1;

        return (
          <li
            class:list={[
              "trail-crumb items-center gap-x-2",
              last ? "flex min-w-0" : "hidden shrink-0 lg:flex",
            ]}
            style={`--index: ${index}`}
          >
            <Chevron class={last ? "max-lg:hidden" : undefined} />
            {crumb.href ? (
              <a href={localizedUrl(crumb.href, lang)} class="transition hover:text-zinc-200">
                {crumb.label}
              </a>
            ) : (
              <span class="truncate text-zinc-300 max-lg:font-medium max-lg:text-zinc-200">
                {crumb.label}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</template>

<style>
  /*
   * Entrée en cascade, transposée de Breadcrumb (smoothui.dev) : chaque niveau
   * arrive décalé de 4 px vers la gauche, à 40 ms d'intervalle. Le composant
   * d'origine est du React piloté par `motion` ; ici rien ne dépend de l'état,
   * donc une animation CSS suffit et n'embarque aucun JS.
   *
   * Le ressort `bounce: 0.1` de l'original est approché par une courbe à léger
   * dépassement : à 0,25 s et sur 4 px, la différence n'est pas perceptible.
   */
  @media (prefers-reduced-motion: no-preference) {
    .crumb {
      animation: crumb-in 0.25s cubic-bezier(0.34, 1.12, 0.64, 1) both;
      animation-delay: calc(var(--index) * 40ms);
    }
  }

  @keyframes crumb-in {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
