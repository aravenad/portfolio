---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  /** Rend un <a> si défini, un <button> sinon. */
  href?: string;
  variant?: "primary" | "secondary";
}

const {
  href,
  variant = "primary",
  class: className,
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center rounded-lg px-5 py-3 font-medium transition";

/*
 * Le bouton plein est un dégradé haut-bas plutôt qu'un aplat blanc : c'est le
 * même éclairage venu du haut que les tuiles et les cartes, appliqué ici à une
 * surface claire. Le secondaire porte l'arête spéculaire des surfaces sombres.
 */
const variants = {
  primary:
    "bg-gradient-to-b from-white to-zinc-300 text-black hover:to-zinc-200",
  secondary: "surface-lit border border-zinc-700 hover:bg-zinc-900",
};

const classes = [base, variants[variant], className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
