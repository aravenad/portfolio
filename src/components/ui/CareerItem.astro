---
import { Icon } from "astro-icon/components";
import type { CareerEntry } from "../../types";

interface Props {
  entry: CareerEntry;
}

const { entry } = Astro.props;
const {
  title,
  organization,
  location,
  period,
  description,
  roles,
  logo,
  icon,
  initials,
} = entry;

/** Sans intitulé propre, l'organisation devient le titre de l'entrée. */
const heading = title ?? organization;
const subtitle = title ? organization : undefined;
---

<li class="flex gap-4 border-b border-zinc-900 py-6 last:border-b-0">
  <span
    class="flex size-12 shrink-0 items-center justify-center rounded-xl border border-zinc-800 bg-zinc-900 p-2"
  >
    {
      logo ? (
        <img src={logo} alt="" width="32" height="32" class="size-full object-contain" />
      ) : icon ? (
        <Icon name={icon} class="size-6 text-zinc-100" />
      ) : (
        <span class="font-mono text-[0.7rem] font-bold tracking-tight text-zinc-400">
          {initials}
        </span>
      )
    }
  </span>

  <div class="min-w-0 flex-1">
    <h3 class="font-medium text-zinc-100">{heading}</h3>

    <p class="mt-1 text-sm text-zinc-400">
      {subtitle}{subtitle && location && " · "}
      {location && <span class="text-zinc-500">{location}</span>}
    </p>

    <p class="mt-2 text-xs uppercase tracking-wide text-zinc-600">{period}</p>

    {description && <p class="mt-3 text-sm leading-6 text-zinc-500">{description}</p>}

    {
      roles && roles.length > 0 && (
        <ol class="mt-5 space-y-5 border-l border-zinc-800 pl-5">
          {roles.map((role) => (
            <li>
              <p class="text-sm font-medium text-zinc-200">
                {role.title}
                {role.contract && (
                  <span class="ml-2 font-normal text-zinc-600">
                    {role.contract}
                  </span>
                )}
              </p>

              <p class="mt-1 text-xs uppercase tracking-wide text-zinc-600">
                {role.period}
              </p>

              {role.description && (
                <p class="mt-2 text-sm leading-6 text-zinc-500">
                  {role.description}
                </p>
              )}
            </li>
          ))}
        </ol>
      )
    }
  </div>
</li>
