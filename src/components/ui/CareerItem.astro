---
import { Icon } from "astro-icon/components";
import Arrow from "./Arrow.astro";
import { useTranslations } from "../../data/ui";
import { getLang, localizedUrl } from "../../lib/i18n";
import type { CareerEntry } from "../../types";

interface Props {
  entry: CareerEntry;
}

const { entry } = Astro.props;
const {
  title,
  organization,
  location,
  period,
  description,
  roles,
  logo,
  icon,
  initials,
  upcoming = false,
  project,
} = entry;

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);

/** Sans intitulé propre, l'organisation devient le titre de l'entrée. */
const heading = title ?? organization;
const subtitle = title ? organization : undefined;
---

{/*
  Une ligne de CV : sur grand écran, la période prend une colonne à gauche, et
  l'entrée s'étire sur toute la largeur de la section. Plus étroit, elle repasse
  sous le titre. Les quatre blocs sont posés sur une grille nommée (en bas).
*/}
<li class="career-item reveal border-b border-zinc-900 py-6 last:border-b-0">
  {/* Une entrée à venir n'a pas encore de matière : pastille en pointillés. */}
  <span
    class:list={[
      "career-logo flex size-12 shrink-0 items-center justify-center rounded-xl border p-2",
      upcoming
        ? "border-dashed border-zinc-700"
        : "border-zinc-800 bg-gradient-to-b from-zinc-800/50 to-zinc-900/60",
    ]}
  >
    {
      logo ? (
        <img src={logo} alt="" width="32" height="32" class="size-full object-contain" />
      ) : icon ? (
        <Icon name={icon} aria-hidden="true" class="size-6 text-zinc-100" />
      ) : (
        <span class="font-mono text-[0.7rem] font-bold tracking-tight text-zinc-400">
          {initials}
        </span>
      )
    }
  </span>

  <div class="career-head min-w-0">
    {/*
      Le titre et la pastille passent à la ligne d'un bloc : sur un écran étroit,
      la pastille glissée dans le texte se coupait en deux (« À » / « venir »).
    */}
    {/* h4 : l'entrée relève de l'intertitre « Expérience » ou « Formation » (h3). */}
    <h4 class="flex flex-wrap items-center gap-x-2 gap-y-1 font-medium text-zinc-100">
      {heading}
      {
        upcoming && (
          <span class="whitespace-nowrap rounded-full border border-accent/30 px-2 py-0.5 text-xs font-normal text-accent">
            {t.career.upcoming}
          </span>
        )
      }
    </h4>

    <p class="mt-1 text-sm text-zinc-400">
      {subtitle}{subtitle && location && " · "}
      {location && <span class="text-zinc-500">{location}</span>}
    </p>
  </div>

  <p class="career-period mt-2 text-xs uppercase tracking-wide text-zinc-500 lg:mt-1 lg:leading-5">
    {period}
  </p>

  <div class="career-body min-w-0">
    {description && <p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-500">{description}</p>}

    {
      project && (
        <a
          href={localizedUrl(`/projects/${project}`, lang)}
          class="group mt-3 inline-flex items-center gap-2 text-sm text-zinc-400 transition hover:text-accent"
        >
          {t.career.seeProject}
          <Arrow class="transition group-hover:translate-x-1" />
        </a>
      )
    }

    {
      roles && roles.length > 0 && (
        <ol class="mt-5 max-w-2xl space-y-5 border-l border-zinc-800 pl-5">
          {roles.map((role) => (
            <li>
              <p class="text-sm font-medium text-zinc-200">
                {role.title}
                {role.contract && (
                  <span class="ml-2 font-normal text-zinc-500">
                    {role.contract}
                  </span>
                )}
              </p>

              <p class="mt-1 text-xs uppercase tracking-wide text-zinc-500">
                {role.period}
              </p>

              {role.description && (
                <p class="mt-2 text-sm leading-6 text-zinc-500">
                  {role.description}
                </p>
              )}
            </li>
          ))}
        </ol>
      )
    }
  </div>
</li>

<style>
  .career-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    grid-template-areas:
      "logo head"
      "logo period"
      "logo body";
    grid-template-rows: auto auto 1fr;
    column-gap: 1rem;
  }

  .career-logo {
    grid-area: logo;
  }

  .career-head {
    grid-area: head;
  }

  .career-period {
    grid-area: period;
  }

  .career-body {
    grid-area: body;
  }

  @media (min-width: 64rem) {
    .career-item {
      grid-template-columns: 11rem 3rem minmax(0, 1fr);
      grid-template-areas:
        "period logo head"
        "period logo body";
      grid-template-rows: auto 1fr;
      column-gap: 1.5rem;
    }
  }
</style>
