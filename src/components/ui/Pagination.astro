---
import Arrow from "./Arrow.astro";

interface Props {
  currentPage: number;
  totalPages: number;
  /** Construit l'URL d'une page donnée. */
  href: (page: number) => string;
  /** Libellé du <nav>, utile si la page contient plusieurs paginations. */
  label?: string;
}

const {
  currentPage,
  totalPages,
  href,
  label = "Pagination",
} = Astro.props;

/**
 * Première page, dernière page et voisines immédiates de la page courante.
 * Les trous sont matérialisés par une ellipsis.
 */
function buildItems(current: number, total: number): (number | "ellipsis")[] {
  const shown = new Set<number>([1, total, current - 1, current, current + 1]);
  const pages = [...shown]
    .filter((page) => page >= 1 && page <= total)
    .sort((a, b) => a - b);

  return pages.flatMap((page, index) => {
    const previous = pages[index - 1];

    return previous !== undefined && page - previous > 1
      ? (["ellipsis", page] as (number | "ellipsis")[])
      : [page];
  });
}

const items = buildItems(currentPage, totalPages);
const hasPrevious = currentPage > 1;
const hasNext = currentPage < totalPages;

const linkBase =
  "inline-flex h-10 items-center justify-center gap-2 rounded-lg border px-3 text-sm font-medium transition";
/* Même largeur pour Précédent et Suivant : sans ça, le bloc des numéros est décentré. */
const stepWidth = "sm:min-w-32";
const inactive =
  "border-zinc-800 text-zinc-400 hover:border-zinc-600 hover:bg-zinc-900 hover:text-zinc-100";
const disabled = "border-zinc-900 text-zinc-700 pointer-events-none";
---

{
  totalPages > 1 && (
    <nav aria-label={label} class="flex justify-center" data-pagination>
      <ul class="flex flex-wrap items-center justify-center gap-2">
        <li>
          <a
            href={hasPrevious ? href(currentPage - 1) : undefined}
            aria-disabled={hasPrevious ? undefined : "true"}
            tabindex={hasPrevious ? undefined : -1}
            class:list={[linkBase, stepWidth, hasPrevious ? inactive : disabled]}
          >
            <Arrow direction="left" />
            <span class="hidden sm:inline">Précédent</span>
            <span class="sr-only sm:hidden">Page précédente</span>
          </a>
        </li>

        {items.map((item, index) =>
          item === "ellipsis" ? (
            <li
              aria-hidden="true"
              class="page-item px-1 text-zinc-600"
              style={`--index: ${index}`}
            >
              …
            </li>
          ) : (
            <li class="page-item" style={`--index: ${index}`}>
              <a
                href={href(item)}
                data-page={item}
                aria-current={item === currentPage ? "page" : undefined}
                aria-label={`Page ${item}`}
                class:list={[
                  linkBase,
                  "relative min-w-10 tabular-nums",
                  item === currentPage
                    ? "border-transparent text-accent"
                    : inactive,
                ]}
              >
                {/*
                  L'état actif est un calque distinct, et non une bordure posée
                  sur le lien : c'est lui qui glisse d'une page à l'autre.
                */}
                {item === currentPage && (
                  <span
                    data-page-indicator
                    aria-hidden="true"
                    class="absolute inset-0 rounded-lg border border-accent/50 bg-accent/10"
                  />
                )}
                <span class="relative">{item}</span>
              </a>
            </li>
          ),
        )}

        <li>
          <a
            href={hasNext ? href(currentPage + 1) : undefined}
            aria-disabled={hasNext ? undefined : "true"}
            tabindex={hasNext ? undefined : -1}
            class:list={[linkBase, stepWidth, hasNext ? inactive : disabled]}
          >
            <span class="hidden sm:inline">Suivant</span>
            <span class="sr-only sm:hidden">Page suivante</span>
            <Arrow />
          </a>
        </li>
      </ul>
    </nav>
  )
}

<style>
  /*
   * Entrée en cascade des numéros, transposée de Pagination (smoothui.dev) :
   * 4 px vers le bas, 30 ms d'intervalle. Les boutons Précédent et Suivant en
   * sont exclus, comme dans le composant d'origine — ils encadrent la série,
   * ils n'en font pas partie.
   */
  @media (prefers-reduced-motion: no-preference) {
    .page-item {
      animation: page-item-in 0.25s cubic-bezier(0.34, 1.12, 0.64, 1) both;
      animation-delay: calc(var(--index) * 30ms);
    }
  }

  @keyframes page-item-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { onEachPage } from "../../lib/enhance";
  import { rememberPage, slideOffset, slideOrigin } from "../../lib/pagination";

  /**
   * Fait glisser le calque actif depuis la page que l'on vient de quitter.
   *
   * Le composant d'origine obtient cet effet avec `layoutId` : le même élément
   * survit au changement d'état et Motion interpole sa position. Ici la
   * pagination navigue vers de vraies URL, donc la page est rechargée et cet
   * élément n'existe plus — il n'y a rien à interpoler.
   *
   * On reconstitue donc le déplacement : la page quittée est retenue en
   * `sessionStorage`, et au chargement suivant le calque est placé sur son
   * ancien bouton puis ramené à sa place (technique FLIP). Le résultat vu par
   * l'utilisateur est le même ; le mécanisme, non.
   *
   * Tout est optionnel : sans `sessionStorage` (navigation privée), sans bouton
   * correspondant à l'ancienne page (l'ellipsis a bougé) ou sous
   * `prefers-reduced-motion`, le calque est simplement déjà en place.
   *
   * Les décisions sont dans src/lib/pagination.ts, où elles sont testées ; il
   * ne reste ici que les mesures et l'animation.
   */
  onEachPage(() => {
    const nav = document.querySelector<HTMLElement>("[data-pagination]");
    const indicator = nav?.querySelector<HTMLElement>("[data-page-indicator]");
    const current = nav?.querySelector<HTMLElement>('[aria-current="page"]');

    if (!nav || !indicator || !current) return;

    const page = current.dataset.page;
    const from = slideOrigin(rememberPage(() => sessionStorage, page), page);
    const origin = from
      ? nav.querySelector<HTMLElement>(`[data-page="${CSS.escape(from)}"]`)
      : null;

    const dx = slideOffset({
      motionOk: !window.matchMedia("(prefers-reduced-motion: reduce)").matches,
      originLeft: origin?.getBoundingClientRect().left,
      currentLeft: current.getBoundingClientRect().left,
    });

    if (dx !== null && typeof indicator.animate === "function") {
      indicator.animate(
        [{ transform: `translateX(${dx}px)` }, { transform: "none" }],
        { duration: 250, easing: "cubic-bezier(0.34, 1.12, 0.64, 1)" },
      );
    }
  });
</script>
