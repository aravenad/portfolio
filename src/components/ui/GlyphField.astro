---
/*
 * La matière du fond, recomposée en glyphes (src/lib/glyph.ts), et le moteur
 * qui trame aussi les couvertures de projet.
 *
 * Trois surfaces, une même boucle à 12 images par seconde :
 *
 * - le fond, en haut de chaque page, anime en continu un reflet qui traverse
 *   la matière ;
 * - ses échos plus bas dans la page et dans le halo du pied de page
 *   (`[data-glyph-echo]`, GlyphEchoes.astro) font de même ;
 * - chaque couverture de carte (`[data-glyph-cover]`, ProjectCover.astro) est
 *   figée, et s'anime le temps du survol ou du focus de sa carte ;
 * - chaque logo (`[data-glyph-logo]`, GlyphLogo.astro : compétences, profils
 *   du contact) aussi, au survol de son hôte `[data-glyph-hote]`, dont il prend
 *   les couleurs de marque. Sa source n'est pas la matière mais son propre SVG,
 *   rendu à un pixel par cellule ;
 * - chaque bouton (`[data-glyph-bouton]`, Button.astro) cache un fragment de
 *   la matière, qui n'apparaît qu'au survol ou au focus, balayé d'un reflet
 *   deux fois plus vif que celui des couvertures.
 *
 * Tout s'arrête avec l'interrupteur « Animer le fond » (`<html data-glyph>`) :
 * chaque surface repasse alors sur une image figée. Une surface hors de
 * l'écran, ou un onglet caché, ne coûte rien.
 *
 * La trame lit une copie réduite de la matière (chrome-glyph.webp, 480 px de
 * large, une cinquantaine de Ko) : un pixel par cellule lui suffit. La photo
 * pleine taille n'est chargée que sans script, où global.css la garde en fond
 * et sur les couvertures.
 *
 * `transition:persist` garde le calque, et sa trame, d'une page à l'autre :
 * le reflet poursuit sa course au lieu de repartir à chaque navigation.
 */
import chromeGlyph from "../../assets/chrome-glyph.webp";
---

<div
  class="glyph-field"
  aria-hidden="true"
  data-glyph-field
  data-glyph-src={chromeGlyph.src}
  transition:persist="glyph-field"
>
  <canvas></canvas>
</div>

<script>
  import { onEachPage } from "../../lib/enhance";
  import {
    BALAYAGE,
    type Cadre,
    NIVEAUX_BOUTON,
    NIVEAUX_MATIERE,
    type Niveaux,
    POLICE,
    TEINTES,
    aLaSource,
    cadrageCouverture,
    cadrageFond,
    champ,
    empreinte,
    fraction,
    grille,
    imageDAtlas,
    peindre,
    trame,
    trameLogo,
  } from "../../lib/glyph";

  const root = document.documentElement;
  const FPS = 12;
  /** Le départ de l'horloge du fond, reculé du temps passé figé (voir `image`). */
  let debut = performance.now();
  /** Combien de millisecondes la peinture par tranches s'accorde par image. */
  const BUDGET = 3;
  /** Lignes peintes d'un coup, entre deux coups d'œil à l'horloge. */
  const LIGNES_PAR_COUP = 4;

  /** Une surface tramée : son canvas, sa grille et ce qu'elle a déjà peint. */
  interface Toile {
    canvas: HTMLCanvasElement;
    /** Taille d'une cellule, en pixels CSS. */
    cellule: number;
    /** La source, et la part de la source pour une surface de `largeur × hauteur`. */
    source: () => Promise<HTMLImageElement | null>;
    cadre: (largeur: number, hauteur: number) => Cadre;
    niveaux: Niveaux;
    /** S'anime-t-elle en ce moment, réglage mis à part ? */
    anime: () => boolean;
    /** Son horloge, en secondes. */
    temps: (maintenant: number) => number;
    /** Un logo : sa source est lue entière, et il a les couleurs de sa marque. */
    logo?: {
      couleurs: () => string[];
      /** Est-il dans ses couleurs en ce moment ? */
      marque: () => boolean;
    };
    visible: boolean;
    etat?: {
      colonnes: number;
      lignes: number;
      pixels: number;
      contexte: CanvasRenderingContext2D;
      tuiles: CanvasImageSource;
      champ: ReturnType<typeof champ> | ReturnType<typeof empreinte>;
      codes: Uint8Array;
      avant: Uint8Array;
      fige: boolean;
      marque: boolean;
    };
  }

  /** La matière du fond, chargée une fois pour toutes les surfaces. */
  let matiere: Promise<HTMLImageElement | null> | undefined;
  function chargerMatiere(src: string) {
    matiere ??= new Promise((resolve) => {
      const image = new Image();
      image.decoding = "async";
      image.onload = () => resolve(image);
      image.onerror = () => resolve(null);
      image.src = src;
    });
    return matiere;
  }

  /** La police de la trame : sans elle, l'atlas serait rendu dans une police de repli. */
  const police = document.fonts?.load(`500 16px ${POLICE}`).catch(() => []) ?? Promise.resolve([]);

  const animationVoulue = () => root.dataset.glyph === "on";

  /** Les couleurs de la palette, lues une fois par thème. */
  let palette: string[] | undefined;

  function couleurs() {
    if (!palette) {
      const style = getComputedStyle(root);
      palette = TEINTES.map((teinte) => style.getPropertyValue(`--glyph-${teinte}`).trim() || "#888");
    }
    return palette;
  }

  /*
   * Les atlas, partagés : les couvertures d'une page, ses boutons, ses échos
   * ont la même taille de cellule et les mêmes couleurs. Une page de projets en
   * rendait un par carte, à chaque navigation. Le thème les périme tous.
   */
  const atlasEnCache = new Map<string, CanvasImageSource>();

  function tuiles(pixels: number, toile: Toile) {
    const teintes = [...couleurs(), ...(toile.logo?.couleurs() ?? [])];
    const cle = `${pixels} ${teintes.join(" ")}`;
    let image = atlasEnCache.get(cle);
    if (!image) {
      image = imageDAtlas(pixels, teintes);
      atlasEnCache.set(cle, image);
    }
    return image;
  }

  function oublierAtlas() {
    for (const image of atlasEnCache.values()) if ("close" in image) image.close();
    atlasEnCache.clear();
    palette = undefined;
  }

  /*
   * Une surface loin de l'écran (couvertures du bas de la liste, logos du
   * pied de page) n'est préparée que quand le navigateur a le temps, ou dès
   * qu'elle approche : préparer toute une page d'un coup, juste après une
   * navigation, faisait sauter des images au moment où la page apparaît.
   */
  const enAttente = new Map<Toile, HTMLImageElement>();
  let attente = 0;
  const quandLibre: (rappel: (delai?: IdleDeadline) => void) => number =
    "requestIdleCallback" in window
      ? (rappel) => requestIdleCallback(rappel, { timeout: 1500 })
      : (rappel) => window.setTimeout(rappel, 120);

  function differer(toile: Toile, source: HTMLImageElement) {
    enAttente.set(toile, source);
    attente ||= quandLibre(viderLAttente);
  }

  function viderLAttente(delai?: IdleDeadline) {
    attente = 0;
    for (const [toile, source] of enAttente) {
      // Il en reste pour la prochaine pause.
      if (delai && delai.timeRemaining() < 4 && !delai.didTimeout) break;
      enAttente.delete(toile);
      if (toiles.includes(toile)) construire(toile, source);
      // Sans échéance, une surface par appel.
      if (!delai) break;
    }
    if (enAttente.size > 0) attente = quandLibre(viderLAttente);
  }

  /** La surface est-elle à l'écran, ou à moins d'un écran de distance ? */
  function proche(rect: DOMRect) {
    return rect.bottom > -window.innerHeight && rect.top < 2 * window.innerHeight;
  }

  /** (Re)construit la grille d'une surface à sa taille actuelle, puis la peint. */
  async function preparer(toile: Toile) {
    const [source] = await Promise.all([toile.source(), police]);
    if (!source) return;
    enAttente.delete(toile);
    if (toile.etat || proche(toile.canvas.parentElement!.getBoundingClientRect())) construire(toile, source);
    else differer(toile, source);
  }

  function construire(toile: Toile, source: HTMLImageElement) {
    const boite = toile.canvas.parentElement!;
    const { width, height } = boite.getBoundingClientRect();
    if (width === 0 || height === 0) return;

    const ratio = window.devicePixelRatio || 1;
    const pixels = Math.max(1, Math.round(toile.cellule * ratio));
    const { colonnes, lignes } = grille(width, height, toile.cellule);

    // Lecture de la source : un pixel par cellule.
    const lecture = document.createElement("canvas");
    lecture.width = colonnes;
    lecture.height = lignes;
    const lecteur = lecture.getContext("2d", { willReadFrequently: true })!;
    lecteur.imageSmoothingQuality = "high";
    if (toile.logo) {
      lecteur.drawImage(source, 0, 0, colonnes, lignes);
    } else {
      const cadre = toile.cadre(colonnes * toile.cellule, lignes * toile.cellule);
      const { sx, sy, sw, sh } = aLaSource(cadre, source.naturalWidth);
      lecteur.drawImage(source, sx, sy, sw, sh, 0, 0, colonnes, lignes);
    }
    const donnees = lecteur.getImageData(0, 0, colonnes, lignes).data;

    const canvas = toile.canvas;
    canvas.width = colonnes * pixels;
    canvas.height = lignes * pixels;
    canvas.style.width = `${(colonnes * pixels) / ratio}px`;
    canvas.style.height = `${(lignes * pixels) / ratio}px`;

    toile.etat = {
      colonnes,
      lignes,
      pixels,
      contexte: canvas.getContext("2d")!,
      tuiles: tuiles(pixels, toile),
      champ: toile.logo ? empreinte(donnees, colonnes, lignes) : champ(donnees, colonnes, lignes),
      codes: new Uint8Array(colonnes * lignes),
      // Redimensionné, le canvas repart vierge : rien à effacer.
      avant: new Uint8Array(colonnes * lignes),
      fige: false,
      marque: false,
    };

    peindreToile(toile, performance.now());
  }

  function peindreToile(toile: Toile, maintenant: number) {
    const etat = toile.etat;
    if (!etat) return;

    const anime = animationVoulue() && toile.anime();
    // Un logo change de couleurs au survol, même quand rien ne s'anime.
    const marque = toile.logo?.marque() ?? false;
    // Figée, une surface n'est peinte qu'une fois.
    if (!anime && etat.fige && marque === etat.marque) return;

    const temps = anime ? toile.temps(maintenant) : null;
    if ("encre" in etat.champ) trameLogo(etat.champ, etat.codes, temps, marque);
    else trame(etat.champ, etat.codes, temps, toile.niveaux);
    peindre(etat.contexte, etat.tuiles, etat.codes, etat.avant, etat.colonnes, etat.pixels);
    etat.fige = !anime;
    etat.marque = marque;
  }

  /** Repeint tout, de zéro : nouvelles couleurs ou nouvel état du réglage. */
  function repeindre(nouvellesCouleurs: boolean) {
    if (nouvellesCouleurs) oublierAtlas();
    for (const toile of toiles) {
      const etat = toile.etat;
      if (!etat) continue;
      if (nouvellesCouleurs) {
        etat.tuiles = tuiles(etat.pixels, toile);
        etat.avant.fill(255);
      }
      etat.fige = false;
    }

    // Hors de la fenêtre, une surface attend d'y revenir : la boucle la
    // repeindra alors.
    const visibles = toiles.filter((toile) => toile.visible && toile.etat);
    if (nouvellesCouleurs && root.getAttribute("data-theme-switching") === "glyph") {
      repeindreParTranches(visibles);
    } else {
      for (const toile of visibles) peindreToile(toile, performance.now());
    }
  }

  /*
   * Au changement de thème par le front de glyphes, tout repeindre d'un bloc
   * (des dizaines de milliers de cellules) retarderait d'autant le départ de la
   * transition. Les surfaces sont donc repeintes aux nouvelles couleurs par
   * tranches de lignes, quelques millisecondes par image, en commençant par la
   * partie visible : le front met plus d'un dixième de seconde à découvrir
   * quoi que ce soit, le temps qu'il faut pour finir.
   *
   * La trame est figée pendant ce temps (voir `image`) : ses codes ne bougent
   * pas, et `avant`, rempli de 255, garantit que rien n'est oublié si la
   * boucle reprend avant la fin.
   */
  let tranches = 0;

  function repeindreParTranches(surfaces: Toile[]) {
    cancelAnimationFrame(tranches);
    const files = surfaces.map((toile) => {
      const { lignes, pixels } = toile.etat!;
      const haut = toile.canvas.getBoundingClientRect().top;
      const premiere = Math.min(lignes - 1, Math.max(0, Math.floor((-haut * (window.devicePixelRatio || 1)) / pixels)));
      // La partie visible d'abord, puis ce qui la précède.
      return { toile, ordre: [...range(premiere, lignes), ...range(0, premiere)], rang: 0 };
    });

    const tranche = () => {
      const limite = performance.now() + BUDGET;
      while (files.length > 0 && performance.now() < limite) {
        const file = files[0];
        const etat = file.toile.etat;
        if (!etat || file.rang >= file.ordre.length) {
          files.shift();
          continue;
        }
        for (const ligne of file.ordre.slice(file.rang, file.rang + LIGNES_PAR_COUP)) {
          const debutLigne = ligne * etat.colonnes;
          peindre(etat.contexte, etat.tuiles, etat.codes, etat.avant, etat.colonnes, etat.pixels, debutLigne, debutLigne + etat.colonnes);
        }
        file.rang += LIGNES_PAR_COUP;
      }
      if (files.length > 0) tranches = requestAnimationFrame(tranche);
    };

    tranches = requestAnimationFrame(tranche);
  }

  function range(de: number, a: number) {
    return Array.from({ length: Math.max(0, a - de) }, (_, i) => de + i);
  }

  let toiles: Toile[] = [];
  let fond: Toile | undefined;
  let boucle = 0;
  let derniere = 0;
  let figee: number | undefined;

  function image(maintenant: number) {
    boucle = requestAnimationFrame(image);
    // Pendant un changement de thème, la trame se fige : l'ancienne page n'est
    // plus qu'une capture immobile, et le front a besoin de chaque image. Elle
    // repart ensuite d'où elle était : un saut d'une seconde la ferait
    // repeindre presque entière d'un coup.
    if (root.hasAttribute("data-theme-switching")) {
      figee ??= maintenant;
      return;
    }
    if (figee !== undefined) {
      debut += maintenant - figee;
      figee = undefined;
    }
    if (document.hidden || maintenant - derniere < 1000 / FPS) return;
    derniere = maintenant;

    for (const toile of toiles) if (toile.visible) peindreToile(toile, maintenant);
  }

  /** Suit la taille et la visibilité d'une surface. */
  function observer(toile: Toile, signal?: AbortSignal) {
    const boite = toile.canvas.parentElement!;
    let largeur = 0;
    let hauteur = 0;

    const taille = new ResizeObserver(([entree]) => {
      const { width, height } = entree.contentRect;
      if (Math.abs(width - largeur) < toile.cellule && Math.abs(height - hauteur) < toile.cellule) return;
      largeur = width;
      hauteur = height;
      void preparer(toile);
    });
    const vue = new IntersectionObserver(([entree]) => {
      toile.visible = entree.isIntersecting;
      // Mise de côté, elle arrive à l'écran avant que le navigateur ait eu le temps.
      const source = enAttente.get(toile);
      if (toile.visible && source) {
        enAttente.delete(toile);
        construire(toile, source);
      }
    });

    taille.observe(boite);
    vue.observe(boite);
    signal?.addEventListener("abort", () => {
      taille.disconnect();
      vue.disconnect();
    });
  }

  function surfaceDuFond(champ: HTMLElement): Toile {
    const src = champ.dataset.glyphSrc!;
    return {
      canvas: champ.querySelector("canvas")!,
      cellule: 9,
      niveaux: NIVEAUX_MATIERE,
      source: () => chargerMatiere(src),
      cadre: (largeur, hauteur) =>
        cadrageFond(largeur, hauteur, parseFloat(getComputedStyle(root).fontSize) || 16),
      anime: () => true,
      temps: (maintenant) => (maintenant - debut) / 1000,
      visible: true,
    };
  }

  /*
   * Survolée, une surface lance un reflet plus vif que celui du fond (trois
   * fois par défaut). Quittée, elle le laisse finir sa traversée avant de se
   * figer : un reflet coupé net au milieu se verrait comme un saut.
   */
  function refletAuSurvol(cible: HTMLElement, signal: AbortSignal, acceleration = 3) {
    let depart: number | undefined;
    let sortie = false;
    let survolee = false;
    const temps = (maintenant: number) => ((maintenant - (depart ?? maintenant)) / 1000) * acceleration;

    const entrer = () => {
      depart ??= performance.now();
      sortie = false;
      survolee = true;
    };
    const sortir = () => {
      sortie = true;
      survolee = false;
    };

    for (const type of ["pointerenter", "focusin"]) cible.addEventListener(type, entrer, { signal });
    for (const type of ["pointerleave", "focusout"]) cible.addEventListener(type, sortir, { signal });

    return {
      anime: () => {
        if (depart === undefined) return false;
        // Le reflet est sorti de la surface : elle peut se figer.
        if (sortie && (temps(performance.now()) % BALAYAGE) / BALAYAGE > 0.95) {
          depart = undefined;
          sortie = false;
          return false;
        }
        return true;
      },
      temps,
      survolee: () => survolee,
    };
  }

  function surfaceDeCouverture(canvas: HTMLCanvasElement, src: string, signal: AbortSignal): Toile {
    const couverture = canvas.parentElement!;
    const carte = couverture.closest<HTMLElement>(".group") ?? couverture;
    const style = getComputedStyle(couverture);
    const x = fraction(style.getPropertyValue("--cover-x"));
    const y = fraction(style.getPropertyValue("--cover-y"));
    const { anime, temps } = refletAuSurvol(carte, signal);

    return {
      canvas,
      cellule: 6,
      niveaux: NIVEAUX_MATIERE,
      source: () => chargerMatiere(src),
      cadre: (largeur, hauteur) => cadrageCouverture(largeur, hauteur, x, y),
      anime,
      temps,
      visible: true,
    };
  }

  /*
   * Un bouton : la matière, comme une couverture, mais en cellules plus fines
   * et cadrée d'un bouton à l'autre sur un autre pli. Son reflet traverse en
   * une seconde et demie : un survol de bouton est bref.
   */
  function surfaceDeBouton(canvas: HTMLCanvasElement, src: string, rang: number, signal: AbortSignal): Toile {
    const { anime, temps } = refletAuSurvol(canvas.parentElement!, signal, 6);
    const x = (0.2 + rang * 0.37) % 1;
    const y = (0.15 + rang * 0.61) % 1;

    return {
      canvas,
      cellule: 5,
      niveaux: NIVEAUX_BOUTON,
      source: () => chargerMatiere(src),
      cadre: (largeur, hauteur) => cadrageCouverture(largeur, hauteur, x, y),
      anime,
      temps,
      visible: true,
    };
  }

  /**
   * Le SVG d'un logo, autonome, prêt à être chargé comme image : les symboles
   * qu'il appelle par `<use>` y sont recopiés, sa couleur principale passe en
   * rouge pur et sa seconde (`--logo-accent`) en vert pur, que lit `empreinte`.
   */
  function dessinDuLogo(svg: SVGSVGElement): string {
    const copie = svg.cloneNode(true) as SVGSVGElement;
    for (const use of copie.querySelectorAll("use")) {
      const id = use.getAttribute("href")?.slice(1) ?? "";
      const symbole = document.getElementById(id);
      if (symbole && !copie.querySelector(`[id="${id}"]`)) copie.prepend(symbole.cloneNode(true));
    }
    copie.setAttribute("xmlns", "http://www.w3.org/2000/svg");
    copie.setAttribute("width", "240");
    copie.setAttribute("height", "240");
    /*
     * Le filet des logos au trait (.skill-icon-line), que le SVG seul n'a pas.
     * Plus épais que sur le SVG (0,35) : à 16 cellules de côté, une cellule
     * couvre 1,5 unité du viewBox, et un trait fin ne laissait que des glyphes
     * épars dans les teintes sombres.
     */
    const filet = svg.classList.contains("skill-icon-line")
      ? "stroke: currentColor; stroke-width: 0.8; stroke-linejoin: round;"
      : "";
    copie.setAttribute("style", `color: #f00; --logo-accent: #0f0; ${filet}`);
    return new XMLSerializer().serializeToString(copie);
  }

  function chargerLogo(svg: SVGSVGElement): Promise<HTMLImageElement | null> {
    return new Promise((resolve) => {
      const image = new Image();
      image.onload = () => resolve(image);
      image.onerror = () => resolve(null);
      image.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(dessinDuLogo(svg))}`;
    });
  }

  function surfaceDeLogo(canvas: HTMLCanvasElement, signal: AbortSignal): Toile | undefined {
    const hote = canvas.closest<HTMLElement>("[data-glyph-hote]");
    const svg = canvas.parentElement?.querySelector<SVGSVGElement>("svg");
    if (!hote || !svg) return;

    let logo: Promise<HTMLImageElement | null> | undefined;
    const { anime, temps, survolee } = refletAuSurvol(hote, signal);

    /*
     * Les couleurs de la marque, comme les règles de survol de SkillTile : la
     * couleur claire en thème clair si la marque en a une, la principale pour
     * la partie secondaire d'un logo qui n'en a pas. Sans couleur (SQL), le
     * logo garde la palette.
     */
    const couleursDeMarque = () => {
      const style = getComputedStyle(hote);
      const lire = (nom: string) => style.getPropertyValue(nom).trim();
      const principale =
        (root.dataset.theme === "light" && lire("--skill-color-light")) || lire("--skill-color");
      return principale ? [principale, lire("--skill-color-2") || principale] : [];
    };

    return {
      canvas,
      cellule: 4,
      niveaux: NIVEAUX_MATIERE,
      source: () => (logo ??= chargerLogo(svg)),
      cadre: () => ({ sx: 0, sy: 0, sw: 0, sh: 0 }),
      anime,
      temps,
      logo: {
        couleurs: couleursDeMarque,
        marque: () => survolee() && couleursDeMarque().length > 0,
      },
      visible: true,
    };
  }

  function surfaceDEcho(canvas: HTMLCanvasElement, src: string, rang: number): Toile {
    const echo = canvas.parentElement!;
    const style = getComputedStyle(echo);
    const x = fraction(style.getPropertyValue("--echo-x"));
    const y = fraction(style.getPropertyValue("--echo-y"));

    return {
      canvas,
      cellule: 9,
      niveaux: NIVEAUX_MATIERE,
      source: () => chargerMatiere(src),
      cadre: (largeur, hauteur) => cadrageCouverture(largeur, hauteur, x, y),
      anime: () => true,
      // Décalés d'un écho à l'autre : les reflets ne passent pas tous ensemble.
      temps: (maintenant) => (maintenant - debut) / 1000 + rang * 2.3,
      visible: true,
    };
  }

  /*
   * Le thème change les couleurs ; l'interrupteur, l'animation. À chaque
   * navigation, le routeur retire puis remet les attributs de `<html>` : les
   * mêmes valeurs reviennent, et rien n'est à repeindre. Les prendre pour un
   * changement de thème repeignait toutes les surfaces au moment du swap.
   */
  let theme = root.dataset.theme;
  let anime = root.dataset.glyph;
  new MutationObserver(() => {
    const nouvellesCouleurs = root.dataset.theme !== theme;
    if (!nouvellesCouleurs && root.dataset.glyph === anime) return;
    theme = root.dataset.theme;
    anime = root.dataset.glyph;
    repeindre(nouvellesCouleurs);
  }).observe(root, { attributes: true, attributeFilter: ["data-theme", "data-glyph"] });

  onEachPage((signal) => {
    const champ = document.querySelector<HTMLElement>("[data-glyph-field]");
    if (!champ || !("ResizeObserver" in window) || !("IntersectionObserver" in window)) return;

    // Le calque persiste d'une page à l'autre : sa surface aussi.
    if (!fond) {
      fond = surfaceDuFond(champ);
      observer(fond);
    }

    const src = champ.dataset.glyphSrc!;
    const page = [
      ...[...document.querySelectorAll<HTMLCanvasElement>("[data-glyph-cover]")].map((canvas) =>
        surfaceDeCouverture(canvas, src, signal),
      ),
      ...[...document.querySelectorAll<HTMLCanvasElement>("[data-glyph-echo]")].map((canvas, rang) =>
        surfaceDEcho(canvas, src, rang),
      ),
      ...[...document.querySelectorAll<HTMLCanvasElement>("[data-glyph-logo]")].flatMap(
        (canvas) => surfaceDeLogo(canvas, signal) ?? [],
      ),
      ...[...document.querySelectorAll<HTMLCanvasElement>("[data-glyph-bouton]")].map((canvas, rang) =>
        surfaceDeBouton(canvas, src, rang, signal),
      ),
    ];

    for (const toile of page) observer(toile, signal);
    toiles = [fond, ...page];

    boucle ||= requestAnimationFrame(image);
  });
</script>
