---
import { Icon } from "astro-icon/components";
import type { Skill } from "../../types";

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;

// Les couleurs de marque ne sont que transportées ici : c'est la règle de survol
// plus bas qui les allume. Une tuile non survolée reste zinc-100, logo bicolore
// compris.
const brand =
  [
    skill.color && `--skill-color: ${skill.color}`,
    skill.color2 && `--skill-color-2: ${skill.color2}`,
  ]
    .filter(Boolean)
    .join("; ") || undefined;
---

<div
  title={skill.label}
  class="skill-tile surface-lit flex aspect-square flex-col items-center justify-center gap-2 rounded-xl border border-zinc-800 bg-gradient-to-b from-zinc-800/50 to-zinc-900/60 p-3 text-center transition hover:border-zinc-600 hover:from-zinc-800/80 hover:to-zinc-800/60"
  style={brand}
>
  {
    skill.icon ? (
      <Icon
        name={skill.icon}
        class:list={[
          "skill-icon size-8 text-zinc-100 transition-colors sm:size-10",
          skill.lineArt && "skill-icon-line",
        ]}
      />
    ) : (
      <span class="font-mono text-base font-bold tracking-tight text-zinc-100">
        {skill.short ?? skill.label}
      </span>
    )
  }

  {/* Inutile de répéter le nom quand la tuile n'affiche que lui. */}
  {
    (skill.icon || skill.short) && (
      <span class="text-[0.65rem] uppercase tracking-wide text-zinc-500">
        {skill.label}
      </span>
    )
  }
</div>

<style>
  /*
   * Le logo reprend la couleur de sa marque au survol de la tuile.
   *
   * `color` porte la couleur principale, que le tracé prend par `currentColor`.
   * `--logo-accent` porte la seconde, pour les logos bicolores — elle n'est
   * définie qu'ici, dans l'état survolé, exactement comme `color` : c'est ce qui
   * garantit qu'un logo bicolore reste monochrome au repos comme ses voisins.
   */
  .skill-tile:hover .skill-icon {
    color: var(--skill-color, currentColor);
    --logo-accent: var(--skill-color-2, currentColor);
  }

  /*
   * Correction de poids optique pour les logos dessinés au trait. Duke, le seul
   * concerné aujourd'hui, ne peint que 16 % de sa boîte là où les glyphes pleins
   * voisins en peignent 33 à 64 % : dans la grille, il paraît délavé.
   *
   * Un filet de contour épaissit son trait sans toucher au dessin. Il est en
   * `currentColor`, donc il suit la couleur de marque au survol comme le
   * remplissage. 0.35 en unités du viewBox (24) : au-delà, les nageoires
   * latérales se referment sur le corps.
   */
  .skill-icon-line {
    stroke: currentColor;
    stroke-width: 0.35;
    stroke-linejoin: round;
  }
</style>
