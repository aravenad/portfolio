---
import type { MarkdownHeading } from "astro";

interface Props {
  /** Titres déjà filtrés par `getTocEntries`. */
  entries: MarkdownHeading[];
  class?: string;
}

const { entries, class: className } = Astro.props;
---

{/*
  La liste du sommaire, rendue telle quelle par les deux formes du composant
  parent. Elle existe à part pour qu'il n'y en ait qu'une à corriger : deux
  copies divergentes afficheraient deux sommaires différents selon la largeur
  de l'écran, et personne ne voit les deux à la fois.
*/}
<div data-toc-list class:list={["overflow-y-auto", className]}>
  <ol>
    {entries.map((heading) => (
      <li>
        {/*
          Aucun filet le long de la liste, ni au survol : il ferait un cadre là
          où la page n'en a pas. L'entrée courante n'est marquée que par la
          couleur de son texte.
        */}
        <a
          href={`#${heading.slug}`}
          data-toc-link
          class:list={[
            "block py-2 text-sm leading-snug text-zinc-500 transition hover:text-zinc-200 aria-[current]:text-accent",
            heading.depth === 2 ? "pl-4" : "pl-8",
          ]}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ol>
</div>
