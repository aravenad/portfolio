---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {}

const { class: className, ...rest } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-full border border-zinc-700/60 bg-zinc-800/50 px-3 py-1 text-xs font-medium text-zinc-400",
    className,
  ]}
  {...rest}
>
  <slot />
</span>
