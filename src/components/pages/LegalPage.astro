---
import Breadcrumb from "../ui/Breadcrumb.astro";
import Container from "../ui/Container.astro";
import SettingSwitch from "../ui/SettingSwitch.astro";
import TableOfContents from "../ui/TableOfContents.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
import { useTranslations } from "../../data/ui";
import { getLang } from "../../lib/i18n";

/**
 * Les mentions légales, dans la langue de l'URL. Rendues par `legal.astro`, en
 * français et en anglais.
 *
 * Ce qu'exige l'article 1-1 de la LCEN d'un éditeur non professionnel : le nom
 * et l'adresse de l'hébergeur. Le nom de l'éditeur et son e-mail vont au-delà,
 * par choix ; son adresse postale et son téléphone restent privés.
 *
 * La mesure d'audience (src/lib/analytics.ts) a sa propre partie, avec
 * l'interrupteur qui permet de la refuser.
 */
const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
const { legal } = t;

/** Les parties de la page, dans l'ordre : leurs titres font le sommaire. */
const tocHeadings = [
  { slug: "legal-publisher", text: legal.publisher.title },
  { slug: "legal-contact", text: legal.contact.title },
  { slug: "legal-host", text: legal.host.title },
  { slug: "legal-domain", text: legal.domain.title },
  { slug: "legal-privacy", text: legal.privacy.title },
  { slug: "legal-analytics", text: legal.privacy.analytics.title },
  { slug: "legal-credits", text: legal.credits.title },
].map((heading) => ({ ...heading, depth: 2 }));

// `scroll-mt-22` : comme les titres des fiches, une ancre du sommaire ne
// s'arrête pas derrière le header collant.
const heading = "scroll-mt-22 text-xl font-semibold text-zinc-100";
const body = "mt-4 space-y-4 leading-7 text-zinc-400";
const link = "text-zinc-200 underline decoration-zinc-600 underline-offset-4 transition hover:text-accent hover:decoration-current";
---

<BaseLayout title={legal.metaTitle} description={legal.metaDescription}>
  <Container class="pt-10">
    <Breadcrumb items={[{ label: legal.title }]} />
  </Container>

  <article class="py-14 sm:py-20">
    <Container>
      <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">{legal.title}</h1>

      {/*
        Le sommaire des fiches projet, à la même place : replié sous le titre
        sur téléphone, collant dans une colonne à droite sur grand écran.
      */}
      <div class="mt-10 lg:mt-12 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-x-12">
        <TableOfContents
          headings={tocHeadings}
          class="border-t border-zinc-900 lg:col-start-2 lg:row-start-1 lg:border-0"
        />

        <div class="mt-10 max-w-2xl space-y-12 lg:col-start-1 lg:row-start-1 lg:mt-0">
          <section aria-labelledby="legal-publisher">
            <h2 id="legal-publisher" class={heading}>{legal.publisher.title}</h2>
            <div class={body}>
              <p>{legal.publisher.text}</p>
              <p>{legal.publisher.anonymity}</p>
            </div>
          </section>

          <section aria-labelledby="legal-contact">
            <h2 id="legal-contact" class={heading}>{legal.contact.title}</h2>
            <div class={body}>
              <p>
                {legal.contact.text}{" "}
                <a href={`mailto:${site.email}`} class={link}>{site.email}</a>
              </p>
            </div>
          </section>

          <section aria-labelledby="legal-host">
            <h2 id="legal-host" class={heading}>{legal.host.title}</h2>
            <address class:list={[body, "not-italic"]}>
              <p>
                <a href={site.host.url} rel="noreferrer" class={link}>{site.host.name}</a><br />
                {site.host.street}<br />
                {site.host.city}<br />
                {legal.host.country}
              </p>
            </address>
          </section>

          <section aria-labelledby="legal-domain">
            <h2 id="legal-domain" class={heading}>{legal.domain.title}</h2>
            <div class={body}>
              <p>{legal.domain.text(site.registrar.domain)}</p>
              <address class="not-italic">
                <a href={site.registrar.url} rel="noreferrer" class={link}>{site.registrar.name}</a><br />
                {site.registrar.street}<br />
                {site.registrar.city}<br />
                {legal.domain.country}
              </address>
            </div>
          </section>

          <section aria-labelledby="legal-privacy">
            <h2 id="legal-privacy" class={heading}>{legal.privacy.title}</h2>
            <div class={body}>
              {legal.privacy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              <p>
                {legal.privacy.hostLogs}{" "}
                <a href={site.host.privacy(lang)} rel="noreferrer" class={link}>{legal.privacy.hostPolicy}</a>.
              </p>
            </div>
          </section>

          <section aria-labelledby="legal-analytics">
            <h2 id="legal-analytics" class={heading}>{legal.privacy.analytics.title}</h2>
            <div class={body}>
              {legal.privacy.analytics.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              <p>
                {legal.privacy.analytics.refusal}{" "}
                <a href={site.analytics.privacy} rel="noreferrer" class={link}>{legal.privacy.analytics.policy}</a>.
              </p>
              {/*
                Caché sans JavaScript : rien n'est alors compté, et l'interrupteur
                ne pourrait rien enregistrer. Le script l'affiche avec son état.
              */}
              <div data-count-box hidden class="rounded-xl border border-zinc-800 p-1 text-zinc-300">
                <SettingSwitch attribute="data-count-toggle" label={legal.privacy.analytics.toggle} />
                <p class="px-3 pb-2 text-sm leading-6 text-zinc-500">{legal.privacy.analytics.toggleHint}</p>
              </div>
            </div>
          </section>

          <section aria-labelledby="legal-credits">
            <h2 id="legal-credits" class={heading}>{legal.credits.title}</h2>
            <div class={body}>
              <p>{legal.credits.text}</p>
            </div>
          </section>
        </div>
      </div>
    </Container>
  </article>
</BaseLayout>

<script>
  /*
   * L'interrupteur de la mesure d'audience : activé tant que le visiteur n'a
   * pas refusé. Le refus se garde sous la clé de GoatCounter (`skipgc`), que
   * le compteur de BaseLayout lit avant chaque page vue.
   */
  import { onEachPage } from "../../lib/enhance";
  import { isCounted, saveCounted } from "../../lib/analytics";

  onEachPage((signal) => {
    const box = document.querySelector<HTMLElement>("[data-count-box]");
    const button = box?.querySelector<HTMLButtonElement>("[data-count-toggle]");
    if (!box || !button) return;

    const store = () => localStorage;
    const show = (counted: boolean) => button.setAttribute("aria-pressed", String(counted));

    show(isCounted(store));
    box.hidden = false;
    button.addEventListener(
      "click",
      () => show(saveCounted(store, button.getAttribute("aria-pressed") !== "true")),
      { signal },
    );
  });
</script>
