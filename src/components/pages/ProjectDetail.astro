---
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import Arrow from "../ui/Arrow.astro";
import Badge from "../ui/Badge.astro";
import Breadcrumb from "../ui/Breadcrumb.astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import ProjectDemo from "../ProjectDemo.astro";
import TableOfContents from "../ui/TableOfContents.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
import { useTranslations } from "../../data/ui";
import { getLang } from "../../lib/i18n";
import { getProjectHref, type Project } from "../../lib/projects";

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}

/**
 * Une fiche projet, dans la langue de l'URL. Rendue par `projects/[slug].astro`
 * en français et en anglais, qui fournissent la fiche et ses voisines
 * (`getProjectPaths`).
 */
const { project, previous, next } = Astro.props;
const { title, summary, tags, status, team, year, links, demo, role, competences, learned } =
  project.data;
const { Content, headings } = await render(project);
const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);

/*
 * Les rubriques de la grille du PPP qui ne vivent pas dans le Markdown, à la
 * suite du corps. Une rubrique vide n'est pas rendue : la fiche reste
 * publiable tant qu'elle n'est pas complète. Ses titres rejoignent ceux du
 * Markdown dans le sommaire.
 */
const sections = [
  { ...t.projects.sections.role, items: role },
  {
    ...t.projects.sections.competences,
    items: competences.map((competence) => t.projects.competences[competence]),
  },
  { ...t.projects.sections.learned, items: learned },
].filter((section) => section.items.length > 0);

const tocHeadings = [
  ...headings,
  ...sections.map(({ slug, title: text }) => ({ depth: 2, slug, text })),
];

const meta = [team, year?.toString()].filter(Boolean);
---

<BaseLayout title={`${title} | ${site.author}`} description={summary}>
  <Container class="pt-10">
    <Breadcrumb
      items={[{ label: t.breadcrumb.projects, href: "/projects" }, { label: title }]}
    />
  </Container>

  <article class="py-14 sm:py-20">
    <Container>
      <header class="border-b border-zinc-900 pb-8 sm:pb-12">
        <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">{title}</h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-400">{summary}</p>

        <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2">
          {tags.map((tag) => <Badge>{tag}</Badge>)}
        </div>

        <p class="mt-5 flex flex-wrap items-center gap-x-2 text-sm text-zinc-500">
          <span
            class:list={[
              status === "en-cours" ? "text-accent" : "text-zinc-400",
            ]}
          >
            {t.projects.status[status]}
          </span>

          {
            meta.length > 0 && (
              <>
                <span aria-hidden="true" class="text-zinc-700">
                  ·
                </span>
                <span>{meta.join(" · ")}</span>
              </>
            )
          }
        </p>

        {/*
          Le site en ligne passe en bouton plein : c'est lui qu'on vient voir.
          Le dépôt suit, à contour, avec le logo GitHub. Sur téléphone, les deux
          prennent la largeur, l'un sous l'autre.

          Les deux s'ouvrent dans un nouvel onglet : on y passe pour revenir à
          la fiche, qui doit rester où on l'a laissée. Le libellé masqué le dit
          aux lecteurs d'écran, la flèche oblique le suggère aux autres.
        */}
        {
          (links.site || links.repo) && (
            <nav
              aria-label={t.projects.links.label}
              class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4"
            >
              {links.site && (
                <Button href={links.site} target="_blank" rel="noopener noreferrer" class="group gap-2">
                  {t.projects.links.site}
                  <span class="sr-only">{` ${t.projects.links.newTab}`}</span>
                  <Arrow class="-rotate-45 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </Button>
              )}
              {links.repo && (
                <Button
                  href={links.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="secondary"
                  class="group gap-2.5"
                >
                  <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
                  {t.projects.links.repo}
                  <span class="sr-only">{` ${t.projects.links.newTab}`}</span>
                  <Arrow class="-rotate-45 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </Button>
              )}
            </nav>
          )
        }
      </header>

      {/*
        La démo vient juste après l'en-tête, avant le texte : on joue d'abord,
        on lit ensuite comment c'est fait.
      */}
      {demo && <ProjectDemo title={title} src={demo.src} caption={demo.caption} />}

      {/*
        Le sommaire occupe la marge droite à partir de `lg`, et passe au-dessus
        du corps de texte en dessous — c'est aussi son ordre dans le document,
        donc celui du clavier et des lecteurs d'écran : on sait ce que contient
        la fiche avant d'y entrer.

        Les deux blocs sont placés explicitement sur la même ligne : c'est la
        hauteur du texte qui donne au sommaire collant sa course.
      */}
      {/*
        Sous lg, le sommaire replié vient se loger contre le filet de l'en-tête,
        qui lui sert de bord haut : un second filet, séparé du premier par un
        vide, faisait une double ligne.
      */}
      <div class="lg:mt-14 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-x-12">
        <TableOfContents headings={tocHeadings} class="lg:col-start-2 lg:row-start-1" />

        <div class="prose mt-8 max-w-3xl sm:mt-10 lg:col-start-1 lg:row-start-1 lg:mt-0">
          <Content />

          {
            sections.map((section) => (
              <>
                <h2 id={section.slug}>{section.title}</h2>
                <ul>
                  {section.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </>
            ))
          }
        </div>
      </div>

      {
        (previous || next) && (
          <nav
            class="mt-16 grid gap-6 border-t border-zinc-900 pt-10 text-sm sm:mt-20 sm:grid-cols-2 sm:gap-4"
            aria-label={t.projects.neighbors}
          >
            {/*
              Une légende au-dessus de chaque titre : sur téléphone, deux titres
              empilés, alignés à gauche, ne disaient pas lequel venait avant. Le
              suivant n'y passe pas à droite : le bouton de retour en haut, collé
              au coin, le recouvrait en bas de page.
            */}
            {previous ? (
              <a
                href={getProjectHref(previous, lang)}
                class="group flex flex-col items-start gap-1 text-zinc-400 transition hover:text-zinc-100"
              >
                <span class="text-xs uppercase tracking-wide text-zinc-500">{t.pagination.previous}</span>
                <span class="flex items-center gap-3">
                  <Arrow
                    direction="left"
                    class="text-zinc-600 transition group-hover:-translate-x-1 group-hover:text-accent"
                  />
                  {previous.data.title}
                </span>
              </a>
            ) : (
              <span />
            )}

            {next && (
              <a
                href={getProjectHref(next, lang)}
                class="group flex flex-col items-start gap-1 text-zinc-400 transition hover:text-zinc-100 sm:items-end sm:text-right"
              >
                <span class="text-xs uppercase tracking-wide text-zinc-500">{t.pagination.next}</span>
                <span class="flex items-center gap-3">
                  {next.data.title}
                  <Arrow class="text-zinc-600 transition group-hover:translate-x-1 group-hover:text-accent" />
                </span>
              </a>
            )}
          </nav>
        )
      }
    </Container>
  </article>
</BaseLayout>
