---
import Container from "../ui/Container.astro";
import { navLinks, site } from "../../data/site";
import { url } from "../../lib/url";

/** Comparaison insensible au slash final ("/projects" et "/projects/"). */
const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
---

{/*
  `transition:persist` garde le header en place d'une page à l'autre : il ne
  clignote pas pendant l'échange, et son animation d'entrée ne rejoue pas à
  chaque navigation — elle appartient à l'ouverture du site, pas à chaque page.
*/}
<header transition:persist class="page-enter page-enter-down sticky top-0 z-50">
  {/*
    Le fond flouté est un calque séparé : un élément portant `backdrop-filter`
    isole ses descendants, et le panneau du menu — s'il était à l'intérieur —
    n'aurait plus la page comme arrière-plan à flouter.
  */}
  <div
    class="absolute inset-x-0 top-0 h-16 border-b border-zinc-900 bg-zinc-950/80 backdrop-blur"
  >
  </div>

  <Container class="relative flex h-16 items-center justify-between gap-4">
    <a
      href={url("/")}
      data-home-link
      class="font-medium tracking-tight transition hover:text-white"
    >
      {site.name}
    </a>

    <nav aria-label="Navigation principale">
      {/* Quatre liens ne tiennent pas à côté du logo sous 640px. */}
      <button
        type="button"
        data-nav-toggle
        aria-controls="nav-menu"
        aria-expanded="false"
        aria-label="Ouvrir le menu"
        class="-mr-2 flex size-10 items-center justify-center rounded-lg text-zinc-300 transition hover:bg-zinc-900 hover:text-white sm:hidden"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
          class="size-5"
        >
          <path class="nav-icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="nav-icon-close hidden" d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>

      <ul
        id="nav-menu"
        class="fixed inset-x-0 top-16 hidden flex-col gap-1 border-b border-zinc-900 bg-zinc-950/80 p-4 text-sm backdrop-blur data-[open]:flex sm:static sm:flex sm:flex-row sm:items-center sm:gap-6 sm:border-0 sm:bg-transparent sm:p-0 sm:backdrop-blur-none"
      >
        {
          navLinks.map((link) => (
            <li>
              <a
                href={url(link.href)}
                data-nav-link
                data-sections={link.sections?.join(" ")}
                aria-current={
                  normalize(url(link.href)) === currentPath ? "page" : undefined
                }
                class="block rounded-lg px-3 py-2.5 text-zinc-400 transition hover:bg-zinc-900 hover:text-zinc-100 aria-[current=page]:text-accent data-[active]:text-accent sm:p-0 sm:hover:bg-transparent"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>

<style>
  /*
   * Marque du lien actif. L'accent argent est trop proche du `zinc-100` du
   * survol pour distinguer les deux états par la seule couleur : l'état actif
   * porte en plus un filet chromé, qui s'éteint sur ses deux bords.
   *
   * Deux positions : sous le libellé une fois la barre horizontale, et calé sur
   * le bas du bouton tant que les liens sont des blocs empilés dans le menu.
   */
  [data-nav-link][aria-current="page"],
  [data-nav-link][data-active] {
    position: relative;
  }

  [data-nav-link][aria-current="page"]::after,
  [data-nav-link][data-active]::after {
    background-image: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      transparent
    );
    bottom: 0.375rem;
    content: "";
    height: 1px;
    inset-inline: 0.75rem;
    position: absolute;
  }

  @media (width >= 40rem) {
    [data-nav-link][aria-current="page"]::after,
    [data-nav-link][data-active]::after {
      bottom: -0.5rem;
      inset-inline: 0;
    }
  }
</style>

<script>
  import { onEachPage } from "../../lib/enhance";
  /**
   * Sur la page d'accueil, le logo remonte en haut au lieu de recharger.
   *
   * Sans cela, cliquer « Damien » depuis le bas de l'accueil relance un
   * chargement complet pour aboutir au même document, tout en haut et d'un coup.
   * Intercepté, le même geste devient un simple défilement.
   *
   * `scrollTo` est appelé sans `behavior` : il suit alors le `scroll-behavior`
   * de la feuille de style, qui respecte déjà `prefers-reduced-motion`. Le
   * clavier et le clic du milieu restent intacts — seul le clic simple, sans
   * modificateur, est détourné.
   */
  onEachPage((signal) => {
    const homeLink = document.querySelector<HTMLAnchorElement>("[data-home-link]");

    if (homeLink) {
      homeLink.addEventListener(
        "click",
        (event) => {
          const plainClick =
            event.button === 0 &&
            !event.metaKey &&
            !event.ctrlKey &&
            !event.shiftKey &&
            !event.altKey;

          const samePage =
            new URL(homeLink.href).pathname.replace(/\/+$/, "") ===
            window.location.pathname.replace(/\/+$/, "");

          if (plainClick && samePage) {
            event.preventDefault();
            window.scrollTo({ top: 0 });
            // L'ancre disparaît de l'URL : le haut de page n'en est pas une.
            history.replaceState(null, "", window.location.pathname);
          }
        },
        { signal },
      );
    }
  });
</script>

<script>
  import { onEachPage } from "../../lib/enhance";

  /**
   * Resynchronise le lien de la page courante après chaque navigation.
   *
   * Le header porte `transition:persist` : son DOM traverse les navigations
   * sans être remplacé. L'`aria-current` rendu par le serveur reste donc figé
   * sur la page d'arrivée initiale — le filet chromé se retrouve sous le mauvais
   * lien, et un lecteur d'écran annonce la mauvaise page courante.
   *
   * La comparaison reprend exactement celle du serveur : le `href` rendu, déjà
   * préfixé de la base, débarrassé de son slash final. Les liens à ancre
   * (« /portfolio/#skills ») ne peuvent ainsi jamais correspondre à un chemin
   * seul, ce qui est voulu — le surlignage au défilement s'en charge.
   */
  onEachPage(() => {
    const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
    const current = normalize(window.location.pathname);

    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")) {
      const href = normalize(link.getAttribute("href") ?? "");

      if (href === current) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    }
  });
</script>

<script>
  import { onEachPage } from "../../lib/enhance";
  /**
   * Menu repliable sous 640px. Le même `<ul>` sert aux deux tailles : dupliquer
   * les liens dédoublerait aussi les cibles du surlignage au défilement.
   */
  onEachPage((signal) => {
    const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const menu = document.getElementById("nav-menu");

    if (toggle && menu) {
      const iconOpen = toggle.querySelector(".nav-icon-open");
      const iconClose = toggle.querySelector(".nav-icon-close");

      const setOpen = (open: boolean) => {
        menu.toggleAttribute("data-open", open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
        iconOpen?.classList.toggle("hidden", open);
        iconClose?.classList.toggle("hidden", !open);
      };

      // `{ signal }` même sur un élément : le header est persisté, ses nœuds
      // survivent à la navigation et les écouteurs s'y accumuleraient.
      toggle.addEventListener(
        "click",
        () => {
          setOpen(!menu.hasAttribute("data-open"));
        },
        { signal },
      );

      // Une ancre ne recharge pas la page : sans ça le menu resterait ouvert.
      for (const link of menu.querySelectorAll("a")) {
        link.addEventListener("click", () => setOpen(false), { signal });
      }

      document.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape" && menu.hasAttribute("data-open")) {
            setOpen(false);
            toggle.focus();
          }
        },
        { signal },
      );

      // Repasser en grand écran laisserait sinon l'état « ouvert » derrière soi.
      window.matchMedia("(min-width: 640px)").addEventListener(
        "change",
        (event) => {
          if (event.matches) setOpen(false);
        },
        { signal },
      );
    }
  });
</script>

<script>
  import { onEachPage } from "../../lib/enhance";
  /**
   * Surligne le lien de la dernière section dont le haut a franchi une ligne de
   * lecture placée au premier tiers de la fenêtre, sous le header collant.
   *
   * « La dernière commencée » plutôt que « celle qui croise la ligne » : entre
   * deux sections, le lien précédent reste allumé au lieu de s'éteindre.
   *
   * Le bas de page est un cas à part : sur un grand écran, la dernière section
   * peut occuper la moitié de la fenêtre sans que son haut ait franchi la ligne
   * de lecture. Puisqu'on ne peut pas défiler plus loin, elle est alors forcée.
   *
   * Le calcul est géométrique plutôt que basé sur IntersectionObserver : celui-ci
   * ne délivre rien tant que l'onglet n'est pas peint, et le choix de la section
   * « la plus visible » est instable quand une section dépasse la hauteur de la
   * fenêtre.
   *
   * Sans section observable (pages autres que l'accueil), rien ne se passe et
   * l'état `aria-current="page"` rendu par le serveur reste seul en place.
   */
  onEachPage((signal) => {
    const HEADER_HEIGHT = 64;
    const READING_LINE = 0.3;

    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
    ];

    const linkBySection = new Map<string, HTMLAnchorElement>();

    for (const link of links) {
      for (const id of (link.dataset.sections ?? "").split(" ").filter(Boolean)) {
        linkBySection.set(id, link);
      }
    }

    const sections = [...linkBySection.keys()]
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => section !== null);

    if (sections.length > 0) {
      sections.sort((a, b) =>
        a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1,
      );

      const update = () => {
        const line =
          HEADER_HEIGHT + (window.innerHeight - HEADER_HEIGHT) * READING_LINE;

        const atBottom =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 1;

        let current = atBottom ? sections[sections.length - 1] : undefined;

        if (!current) {
          let closest = -Infinity;

          for (const section of sections) {
            const { top } = section.getBoundingClientRect();

            if (top <= line && top > closest) {
              closest = top;
              current = section;
            }
          }
        }

        const active = current ? linkBySection.get(current.id) : undefined;

        for (const link of links) {
          if (link === active) {
            link.dataset.active = "";
          } else {
            delete link.dataset.active;
          }
        }
      };

      update();
      window.addEventListener("scroll", update, { passive: true, signal });
      window.addEventListener("resize", update, { signal });
    }
  });
</script>
