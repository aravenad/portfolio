---
import Container from "../ui/Container.astro";
import SettingSwitch from "../ui/SettingSwitch.astro";
import { navLinks, navLinksEn, site } from "../../data/site";
import { useTranslations } from "../../data/ui";
import { getLang, localized, localizedUrl, switchLangPath } from "../../lib/i18n";
import { ariaCurrentFor } from "../../lib/nav";

const currentPath = Astro.url.pathname;
const lang = getLang(currentPath);
const t = useTranslations(lang);
const links = localized(lang, { fr: navLinks, en: navLinksEn });
const otherLang = lang === "fr" ? "en" : "fr";

/** Règle partagée avec le script de resynchronisation : voir src/lib/nav.ts. */
const ariaCurrent = (href: string) => ariaCurrentFor(localizedUrl(href, lang), currentPath);

/**
 * Les petits boutons de la barre : menu, langue, réglages. Sous 48rem, ils sont
 * seuls à côté du logo et marquent le survol d'un fond, comme le menu.
 */
const control =
  "flex size-10 cursor-pointer items-center justify-center rounded-lg text-zinc-300 transition hover:bg-zinc-900 hover:text-white";

/**
 * Langue et réglages au-delà de 48rem : ils rejoignent les liens de navigation et
 * en prennent le survol (la couleur seule, sans fond) et le texte. Un pavé
 * plein, posé sur la matière du haut de page, s'y lisait comme un autocollant.
 */
const setting = [
  control,
  "text-sm font-medium md:text-zinc-400 md:hover:bg-transparent md:hover:text-zinc-100",
];

/**
 * Les interrupteurs d'affichage, rendus deux fois : dans le panneau de
 * l'engrenage au-delà de 48rem, au pied du menu replié en deçà. Le script les
 * câble ensemble, ils disent donc toujours le même état.
 */
const switches = [
  { attribute: "data-theme-toggle", label: t.header.lightTheme },
  { attribute: "data-shine-toggle", label: t.header.animateTitles },
];
---

{/*
  `transition:persist` garde le header en place d'une page à l'autre : il ne
  clignote pas pendant l'échange, et son animation d'entrée ne rejoue pas à
  chaque navigation — elle appartient à l'ouverture du site, pas à chaque page.

  Le nom inclut la langue : passer à l'autre langue remplace le header, au lieu
  de garder des liens et des libellés qui ne sont plus les bons.
*/}
{/*
  Deux états, pilotés par `data-scrolled` (script plus bas) :

  - en haut de page, la barre est nue — pas de fond — et le logo et les liens
    sont écartés vers les bords ;
  - dès qu'on descend, elle reprend la largeur du contenu et son fond flouté.

  Le rendu serveur est l'état « en haut » : c'est celui de toute page ouverte
  depuis un lien.
*/}
<header
  transition:persist={`header-${lang}`}
  class="page-enter page-enter-down sticky top-0 z-50"
>
  {/*
    Le fond flouté est un calque séparé : un élément portant `backdrop-filter`
    isole ses descendants, et le panneau du menu — s'il était à l'intérieur —
    n'aurait plus la page comme arrière-plan à flouter.
  */}
  <div
    class="header-backdrop pointer-events-none absolute inset-x-0 top-0"
    aria-hidden="true"
  >
  </div>

  <Container class="header-bar relative flex h-16 items-center justify-between gap-4">
    {/*
      Le nom, puis le fil d'Ariane de la page une fois celui-ci défilé sous la
      barre : le nom en devient le premier niveau, à la place de « Accueil ». Le
      fil est recopié du `<template>` que rend chaque Breadcrumb (script plus
      bas) ; vide sur les pages qui n'en ont pas.

      Sous 1024 px, à côté du nom et des liens, il ne restait au titre que trois
      lettres : le fil s'y pose donc par-dessus le nom, qui s'efface le temps
      qu'il est là. `flex-1` lui donne toute la place jusqu'aux liens.
    */}
    <div class="header-start relative flex min-w-0 flex-1 items-center">
      <a
        href={localizedUrl("/", lang)}
        data-home-link
        class="shrink-0 font-semibold tracking-tight transition hover:text-white"
      >
        {site.brand}
      </a>

      <div
        data-header-trail
        class="header-trail absolute inset-0 flex min-w-0 items-center lg:static"
      >
      </div>
    </div>

    {/*
      Navigation, langue et réglages, écartés ensemble vers le bord en haut de page.

      Deux listes des mêmes liens, chacune à sa place dans l'ordre de tabulation
      (RGAA 12.8) : celle de la barre large avant la langue et les réglages, celle du
      menu replié après son bouton. Une seule liste, remontée en tête de la barre
      par CSS (`order`), faisait passer le focus du nom à « EN » puis au thème,
      avant de revenir aux liens qu'on voyait pourtant en premier. Une seule des
      deux est affichée à la fois : l'autre, en `display: none`, sort aussi de
      l'arbre d'accessibilité, et un lecteur d'écran ne lit qu'une navigation.

      Sous 48rem, les liens et les réglages vivent dans le panneau déplié :
      restent visibles la langue, puis le bouton du menu, au bord. L'engrenage y
      disparaît : à côté du menu, deux icônes de « plus d'options » se
      faisaient concurrence. En rem et non en px : la barre large demande 43rem, et ce seuil suit la taille de police choisie par
      le visiteur (RGAA 10.4). L'ancien seuil, 40rem, était trop juste : le nom
      recouvrait « À propos » à 640 px, et jusqu'à 1 350 px avec une police à 200 %.
    */}
    <div class="header-end -mr-2 flex shrink-0 items-center gap-1 md:gap-0">
      {/*
        Un filet sépare la navigation des deux réglages : ce sont des
        préférences, pas des destinations.
      */}
      <nav
        aria-label={t.header.navLabel}
        data-nav-bar
        class="hidden md:flex md:items-center md:after:ml-4 md:after:mr-1 md:after:h-4 md:after:w-px md:after:bg-current md:after:opacity-25 md:after:content-['']"
      >
        <ul class="flex items-center gap-6 text-sm">
          {
            links.map((link) => (
              <li>
                <a
                  href={localizedUrl(link.href, lang)}
                  data-nav-link
                  data-sections={link.sections?.join(" ")}
                  aria-current={ariaCurrent(link.href)}
                  class="block font-medium text-zinc-400 transition hover:text-zinc-100 aria-[current]:text-accent data-[active]:text-accent"
                >
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a
        href={switchLangPath(currentPath, otherLang)}
        hreflang={otherLang}
        lang={otherLang}
        data-lang-switch
        aria-label={t.header.otherLang.label}
        class:list={setting}
      >
        {t.header.otherLang.short}
      </a>

      <button
        type="button"
        popovertarget="settings-panel"
        data-settings-toggle
        aria-label={t.header.settings}
        class:list={[setting, "max-md:hidden"]}
      >
        {/* Icône « settings » de Lucide (licence ISC). */}
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="settings-icon size-5"
        >
          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </button>

      {/*
        Panneau des réglages d'affichage : le thème, et le reflet des titres
        chromés, qui tourne en boucle et doit donc pouvoir être arrêté et relancé
        depuis la page (RGAA 13.8).

        Un `popover` natif : l'engrenage l'ouvre sans script, Échap et un clic à
        côté le ferment, et l'engrenage s'annonce déplié (`aria-expanded`). Placé
        juste après l'engrenage dans le code, ses interrupteurs suivent celui-ci
        dans l'ordre de tabulation (RGAA 12.8), avant le bouton du menu. Le
        panneau vit dans la couche supérieure : le `transform` du groupe de
        droite ne l'enferme pas, et le script le cale sous l'engrenage.

        Les interrupteurs : voir SettingSwitch. Sous 48rem, l'engrenage est
        masqué et les mêmes interrupteurs se retrouvent au pied du menu replié.
      */}
      <div
        id="settings-panel"
        popover
        role="group"
        aria-labelledby="settings-title"
        class="settings-panel w-60 max-w-[calc(100vw-2rem)] rounded-xl border border-zinc-800 bg-zinc-950/97 p-2 text-sm text-zinc-200 shadow-xl backdrop-blur-md"
      >
        <p id="settings-title" class="px-3 pt-1 pb-2 text-xs font-medium text-zinc-400">
          {t.header.settingsTitle}
        </p>
        <ul class="flex flex-col gap-1">
          {
            switches.map((option) => (
              <li>
                <SettingSwitch attribute={option.attribute} label={option.label} />
              </li>
            ))
          }
        </ul>
      </div>

      <nav aria-label={t.header.navLabel} class="md:hidden">
        {/* Cinq liens ne tiennent pas à côté du logo sous 48rem. */}
        <button
          type="button"
          data-nav-toggle
          aria-controls="nav-menu"
          aria-expanded="false"
          aria-label={t.header.openMenu}
          data-label-open={t.header.openMenu}
          data-label-close={t.header.closeMenu}
          class={control}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
            class="size-5"
          >
            <path class="nav-icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
            <path class="nav-icon-close hidden" d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>

        {/*
          Déplié, le panneau est la surface de la barre elle-même, prolongée vers
          le bas : il part du haut de l'écran et glisse sous le logo et le bouton
          (`-z-10`). Il commençait à 64 px, avec un fond et un flou différents
          posés sur le fondu de la barre : la jonction formait une marche visible.
          `pt-20` = la hauteur de la barre plus le `p-4`.

          ⚠️ Fond opaque à 97 %, pas à 88 % comme la barre fermée. Le flou ne
          suffit pas à effacer ce qui passe dessous : mesuré sur Chrome, le titre
          de l'accueil restait net et lisible derrière les liens. Le fond doit
          donc couvrir seul ; le flou n'est qu'un complément là où il s'applique.
        */}
        <div
          id="nav-menu"
          class="fixed inset-x-0 top-0 -z-10 hidden flex-col gap-1 border-b border-zinc-900 bg-zinc-950/97 p-4 pt-20 text-sm backdrop-blur-md data-[open]:flex"
        >
          <ul class="flex flex-col gap-1">
            {
              links.map((link) => (
                <li>
                  <a
                    href={localizedUrl(link.href, lang)}
                    data-nav-link
                    data-sections={link.sections?.join(" ")}
                    aria-current={ariaCurrent(link.href)}
                    class="block rounded-lg px-3 py-2.5 font-medium text-zinc-400 transition hover:bg-zinc-900 hover:text-zinc-100 aria-[current]:text-accent data-[active]:text-accent"
                  >
                    <span>{link.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>

          {/*
            Les réglages de l'engrenage, masqué sous 48rem : après les liens,
            sous un filet, comme le panneau large les met après la navigation.
          */}
          <div
            role="group"
            aria-labelledby="menu-settings-title"
            class="mt-2 border-t border-zinc-900 pt-3 text-zinc-200"
          >
            <p id="menu-settings-title" class="px-3 pb-2 text-xs font-medium text-zinc-400">
              {t.header.settingsTitle}
            </p>
            <ul class="flex flex-col gap-1">
              {
                switches.map((option) => (
                  <li>
                    <SettingSwitch attribute={option.attribute} label={option.label} />
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </nav>
    </div>
  </Container>
</header>

<style>
  /* Garder le fond lisible derrière la navigation, puis l'estomper au-delà
   * de la barre : ni bordure ni arrêt brutal du flou à 64 pixels.
   */
  .header-backdrop {
    height: 8rem;
    /* La couleur du fond de page, qui suit le thème. */
    background: color-mix(in oklab, var(--color-zinc-950) 88%, transparent);
    backdrop-filter: blur(12px);
    mask-image: linear-gradient(
      to bottom,
      #000 0,
      #000 2.5rem,
      rgb(0 0 0 / 88%) 3.5rem,
      rgb(0 0 0 / 55%) 4.5rem,
      rgb(0 0 0 / 18%) 6rem,
      transparent 8rem
    );
  }

  /*
   * Passage entre les deux états.
   *
   * ⚠️ Uniquement de l'opacité et des `transform` : le compositeur les anime
   * seul, image par image, sans toucher à la mise en page. La première version
   * animait `max-width` — chaque image relançait la mise en page de la barre
   * pendant le défilement, et le texte, recalé au pixel, avançait par saccades.
   *
   * La barre garde donc toujours sa largeur de contenu (72rem). En haut de
   * page, le logo et la liste de liens sont seulement décalés vers les bords,
   * du même écart qu'une barre élargie à 84rem : `--spread`, nul sous 72rem.
   *
   * Une seule durée et une seule courbe pour tout — fond, positions, couleur
   * des liens. La courbe démarre en douceur et ralentit à l'arrivée : une
   * courbe de sortie (qui parcourt la moitié du trajet dans le premier tiers)
   * donnait à la barre un départ brusque, perçu comme trop rapide.
   */
  header {
    --bar-duration: 0.8s;
    --bar-ease: cubic-bezier(0.4, 0, 0.2, 1);
  }


  .header-backdrop {
    transition: opacity var(--bar-duration) var(--bar-ease);
  }

  header:not([data-scrolled]) .header-backdrop {
    opacity: 0;
  }

  /*
   * Grand écran seulement, et pas par confort : un `transform`, même nul, fait
   * de son élément le bloc conteneur des descendants en `position: fixed`. Posé
   * sur le groupe de droite en mobile, il enfermerait le panneau déplié du menu
   * dans la barre.
   */
  @media (width >= 72rem) {
    .header-bar {
      --spread: calc((min(100vw, 84rem) - 72rem) / 2);
    }

    .header-end {
      transition: transform var(--bar-duration) var(--bar-ease);
    }

    /*
     * Le groupe du nom, et non le nom seul : le fil d'Ariane qui le suit doit
     * partir du même endroit. Le survol du nom reste sur le lien lui-même.
     */
    .header-start {
      transition: transform var(--bar-duration) var(--bar-ease);
    }

    header:not([data-scrolled]) .header-start {
      transform: translateX(calc(-1 * var(--spread)));
    }

    header:not([data-scrolled]) .header-end {
      transform: translateX(var(--spread));
    }
  }

  /*
   * Sans fond, les liens reposent directement sur la matière. Mesuré sur ses
   * reflets les plus clairs (95e centile, de 1280 à 1920 px), le `zinc-400`
   * habituel tombe à 2,5:1 — loin des 4,5:1 d'un texte. Le `zinc-200` tombait
   * encore à 4,4:1 sur « Compétences » à 1280 px (audit RGAA, 12 octobre 2026) :
   * le `zinc-100` remonte ce pire cas autour de 5:1. Le survol passe alors à
   * l'encre maximale (`white`) pour rester perceptible ; le lien actif garde
   * l'accent.
   *
   * Le lien de langue et l'engrenage suivent exactement les mêmes règles que
   * les liens : même couleur, même rythme, même survol.
   *
   * La couleur suit le même rythme que le reste ; seul le survol reste vif.
   *
   * Grand écran seulement : sous 48rem, les liens vivent dans le panneau
   * déplié, qui a son propre fond. Seul le bouton du menu reste sur la matière,
   * et son `zinc-300` y tient déjà.
   */
  @media (width >= 48rem) {
    :is([data-nav-link], [data-lang-switch], [data-settings-toggle]) {
      transition:
        color var(--bar-duration) var(--bar-ease),
        background-color 0.15s;
    }

    :is([data-nav-link], [data-lang-switch], [data-settings-toggle]):hover {
      transition-duration: 0.15s;
    }

    header:not([data-scrolled])
      :is([data-nav-link], [data-lang-switch], [data-settings-toggle]):not(
        :hover,
        [aria-current],
        [data-active]
      ) {
      color: var(--color-zinc-100);
    }

    header:not([data-scrolled])
      :is([data-nav-link], [data-lang-switch], [data-settings-toggle]):hover:not(
        [aria-current],
        [data-active]
      ) {
      color: var(--color-white);
    }
  }

  /*
   * Fil d'Ariane de la barre (script plus bas). Il entre comme celui de la page,
   * en cascade : chaque niveau glisse de 4 px vers la droite, à 40 ms
   * d'intervalle, sur la même courbe à léger dépassement. Il repart d'un bloc,
   * plus vite : une sortie n'a rien à raconter.
   *
   * ⚠️ LE NOM ET LE FIL SE SUCCÈDENT, ILS NE SE CHEVAUCHENT PAS. Le nom change
   * d'abord (il se réduit au-delà de 1024 px, s'efface en deçà), le fil n'entre
   * qu'ensuite ; au retour, le fil repart avant que le nom ne revienne. Menés
   * ensemble, le nom qui rétrécissait tirait le fil de 11 px vers la gauche
   * pendant qu'il glissait de 4 px vers la droite : le premier chevron avançait,
   * puis reculait d'un cran avant la fin. Sous 1024 px, l'effacement du nom se
   * chevauchait avec l'entrée au même endroit. `--trail-wait` est cette attente,
   * soit la durée du changement du nom comme du départ du fil.
   *
   * Caché, il est aussi `visibility: hidden`, et pas seulement transparent : ses
   * liens sortent de l'ordre de tabulation et de ce que lit un lecteur d'écran.
   * La visibilité bascule à la fin du fondu de sortie, au début de l'entrée.
   *
   * `:global` : les niveaux viennent du `<template>` de Breadcrumb, et ne
   * portent donc pas l'attribut de portée des styles de ce composant.
   */
  header {
    --trail-wait: 0.15s;
  }

  .header-trail :global(.trail-crumb) {
    opacity: 0;
    translate: -4px 0;
    visibility: hidden;
    transition:
      opacity var(--trail-wait) ease-in,
      translate var(--trail-wait) ease-in,
      visibility 0s linear var(--trail-wait);
  }

  header[data-scrolled][data-trail] .header-trail :global(.trail-crumb) {
    opacity: 1;
    translate: none;
    visibility: visible;
    transition:
      opacity 0.25s ease-out,
      translate 0.25s cubic-bezier(0.34, 1.12, 0.64, 1),
      visibility 0s;
    transition-delay: calc(var(--trail-wait) + var(--index) * 40ms);
  }

  /*
   * Posé par-dessus le nom sous 1024 px, le conteneur du fil ne doit pas lui
   * prendre ses clics quand il est vide ou caché : seuls ses niveaux visibles
   * en reçoivent.
   */
  .header-trail {
    pointer-events: none;
  }

  .header-trail :global(.trail-crumb) {
    pointer-events: auto;
  }

  /*
   * Au-delà de 1024 px, le nom devient le premier niveau du fil : il en prend
   * le gris, la taille, la graisse et l'approche, comme « Projets », pour que
   * seule la page courante ressorte. Son survol reste celui du nom.
   *
   * Noto Sans est variable : la graisse s'interpole au lieu de sauter, comme la
   * taille. Le nom se réduit avant que le fil n'arrive, et reprend sa taille une
   * fois le fil reparti (voir `--trail-wait`). La couleur, elle, n'attend pas :
   * la même transition sert au survol, qui doit répondre tout de suite.
   */
  @media (width >= 64rem) {
    [data-home-link] {
      transition:
        color 0.15s,
        font-size var(--trail-wait) ease-out var(--trail-wait),
        font-weight var(--trail-wait) ease-out var(--trail-wait),
        letter-spacing var(--trail-wait) ease-out var(--trail-wait);
    }

    header[data-scrolled][data-trail] [data-home-link] {
      font-size: var(--text-sm);
      font-weight: 400;
      letter-spacing: normal;
      transition:
        color 0.15s,
        font-size var(--trail-wait) ease-out,
        font-weight var(--trail-wait) ease-out,
        letter-spacing var(--trail-wait) ease-out;
    }

    header[data-scrolled][data-trail] [data-home-link]:not(:hover) {
      color: var(--color-zinc-500);
    }
  }

  /*
   * Sous 1024 px, le nom s'efface avant que le fil ne prenne sa place, et ne
   * revient qu'une fois le fil reparti (voir `--trail-wait`).
   */
  @media (width < 64rem) {
    [data-home-link] {
      transition:
        color 0.15s,
        opacity var(--trail-wait) ease-out var(--trail-wait),
        visibility 0s linear var(--trail-wait);
    }

    header[data-scrolled][data-trail] [data-home-link] {
      opacity: 0;
      visibility: hidden;
      transition:
        color 0.15s,
        opacity var(--trail-wait) ease-in,
        visibility 0s linear var(--trail-wait);
    }
  }

  /* Sans mouvement, il ne reste que le fondu. */
  @media (prefers-reduced-motion: reduce) {
    .header-trail :global(.trail-crumb) {
      translate: none;
    }
  }

  /* Premier affichage déjà défilé (rechargement, ancre) : pas d'animation. */
  header[data-instant] .header-backdrop,
  header[data-instant] .header-start,
  header[data-instant] .header-end,
  header[data-instant] :is([data-nav-link], [data-lang-switch], [data-settings-toggle]),
  header[data-instant] .header-trail :global(.trail-crumb),
  header[data-instant] [data-home-link] {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-backdrop,
    .header-start,
    .header-end,
    :is([data-nav-link], [data-lang-switch], [data-settings-toggle]) {
      transition: none;
    }
  }

  /*
   * Panneau des réglages. Le style par défaut d'un `popover` le centre dans la
   * fenêtre : il est remis ici dans l'angle, sous la barre, et le script l'aligne
   * ensuite sur l'engrenage. `display: flex` est réservé à l'état ouvert, sinon
   * il l'emporterait sur le `display: none` qui le cache.
   */
  .settings-panel {
    inset: 4.5rem 1rem auto auto;
    margin: 0;
  }

  .settings-panel:popover-open {
    display: flex;
    flex-direction: column;
  }

  /*
   * Le panneau descend de 4 px en apparaissant, l'engrenage tourne d'un cran.
   * Le départ de l'entrée vient de `@starting-style` ; `allow-discrete` laisse
   * le panneau visible le temps de son fondu de sortie.
   */
  .settings-panel {
    opacity: 0;
    translate: 0 -4px;
    transition:
      opacity 0.15s ease-in,
      translate 0.15s ease-in,
      display 0.15s allow-discrete,
      overlay 0.15s allow-discrete;
  }

  .settings-panel:popover-open {
    opacity: 1;
    translate: none;
    transition:
      opacity 0.2s ease-out,
      translate 0.2s cubic-bezier(0.34, 1.12, 0.64, 1),
      display 0.2s allow-discrete,
      overlay 0.2s allow-discrete;
  }

  @starting-style {
    .settings-panel:popover-open {
      opacity: 0;
      translate: 0 -4px;
    }
  }

  .settings-icon {
    transition: rotate 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  header:has(.settings-panel:popover-open) .settings-icon {
    rotate: 45deg;
  }

  /* Sans mouvement : fondu seul pour le panneau, saut net pour l'engrenage. */
  @media (prefers-reduced-motion: reduce) {
    .settings-panel,
    .settings-panel:popover-open,
    .settings-icon {
      translate: none;
    }

    .settings-icon {
      transition: none;
    }

    header:has(.settings-panel:popover-open) .settings-icon {
      rotate: none;
    }
  }

  /*
   * Menu déplié : le panneau prend le relais du fond de la barre. Laissé en
   * place, ce calque ajouterait son voile et son fondu par-dessus le panneau, et
   * le haut du menu serait plus sombre que le reste.
   */
  header:has(#nav-menu[data-open]) .header-backdrop {
    opacity: 0;
  }

  /*
   * Marque du lien actif. L'accent argent est trop proche du `zinc-100` du
   * survol pour distinguer les deux états par la seule couleur : l'état actif
   * porte en plus un filet chromé, qui s'éteint sur ses deux bords.
   *
   * Le filet est porté par le libellé, pas par le lien : dans le menu mobile, le
   * lien est un bloc pleine largeur et le filet, dont l'éclat est au centre,
   * brillait alors sous le vide à droite d'un texte aligné à gauche. Accroché au
   * `<span>`, il reste centré sous le mot dans les deux dispositions.
   */
  [data-nav-link][aria-current] > span,
  [data-nav-link][data-active] > span {
    position: relative;
  }

  [data-nav-link][aria-current] > span::after,
  [data-nav-link][data-active] > span::after {
    background-image: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      transparent
    );
    bottom: -0.25rem;
    content: "";
    height: 1px;
    inset-inline: 0;
    position: absolute;
  }

  @media (width >= 48rem) {
    [data-nav-link][aria-current] > span::after,
    [data-nav-link][data-active] > span::after {
      bottom: -0.5rem;
    }
  }
</style>

<script>
  import { onEachPage } from "../../lib/enhance";
  /**
   * Sur la page d'accueil, le logo remonte en haut au lieu de recharger.
   *
   * Sans cela, cliquer « Damien » depuis le bas de l'accueil relance un
   * chargement complet pour aboutir au même document, tout en haut et d'un coup.
   * Intercepté, le même geste devient un simple défilement.
   *
   * `scrollTo` est appelé sans `behavior` : il suit alors le `scroll-behavior`
   * de la feuille de style, qui respecte déjà `prefers-reduced-motion`. Le
   * clavier et le clic du milieu restent intacts — seul le clic simple, sans
   * modificateur, est détourné.
   */
  onEachPage((signal) => {
    const homeLink = document.querySelector<HTMLAnchorElement>("[data-home-link]");

    if (homeLink) {
      homeLink.addEventListener(
        "click",
        (event) => {
          const plainClick =
            event.button === 0 &&
            !event.metaKey &&
            !event.ctrlKey &&
            !event.shiftKey &&
            !event.altKey;

          const samePage =
            new URL(homeLink.href).pathname.replace(/\/+$/, "") ===
            window.location.pathname.replace(/\/+$/, "");

          if (plainClick && samePage) {
            event.preventDefault();
            window.scrollTo({ top: 0 });
            // L'ancre disparaît de l'URL : le haut de page n'en est pas une.
            history.replaceState(null, "", window.location.pathname);
          }
        },
        { signal },
      );
    }
  });
</script>

<script>
  import { onEachPage } from "../../lib/enhance";
  import { ariaCurrentFor } from "../../lib/nav";

  /**
   * Resynchronise le lien de la page courante après chaque navigation.
   *
   * Le header porte `transition:persist` : son DOM traverse les navigations
   * sans être remplacé. L'`aria-current` rendu par le serveur reste donc figé
   * sur la page d'arrivée initiale — le filet chromé se retrouve sous le mauvais
   * lien, et un lecteur d'écran annonce la mauvaise page courante.
   *
   * La règle est celle du rendu serveur, `ariaCurrentFor` (src/lib/nav.ts),
   * appliquée au `href` rendu, déjà préfixé de la base. Les liens à ancre
   * (« /#skills ») ne peuvent ainsi jamais correspondre à un chemin
   * seul, ce qui est voulu — le surlignage au défilement s'en charge.
   */
  onEachPage(() => {
    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")) {
      const value = ariaCurrentFor(link.getAttribute("href") ?? "", window.location.pathname);

      if (value) link.setAttribute("aria-current", value);
      else link.removeAttribute("aria-current");
    }
  });
</script>

<script>
  import { onEachPage } from "../../lib/enhance";
  import { barReturnThreshold, initialBarScrolled, nextBarScrolled, trailInBar } from "../../lib/nav";

  /**
   * Bascule la barre entre ses deux états selon le défilement.
   *
   * Les deux sens n'ont pas le même seuil :
   *
   * - en descendant, la barre prend son fond dès 8 px — ce qui absorbe aussi le
   *   rebond élastique des navigateurs mobiles, qui la ferait clignoter en haut ;
   * - en remontant, elle se détend plus tôt, pour que ses 0,8 s de transition se
   *   jouent pendant la remontée et non une fois arrivé en haut. Au plus 200 px
   *   avant le haut, et jamais au-delà du premier texte de la page : nue, la
   *   barre ne doit se poser sur aucun mot. Sur l'accueil, le hero laisse toute
   *   la marge ; sur les pages projets, le fil d'Ariane la réduit à ~58 px.
   *
   * ⚠️ Le tout premier alignement se fait sans transition. Une page rechargée
   * au milieu, ou ouverte sur une ancre, arrive déjà défilée : sans cela, la
   * barre s'animerait toute seule sous les yeux du lecteur. Les navigations
   * suivantes, elles, gardent l'animation — le header persiste d'une page à
   * l'autre, et le voir se détendre en arrivant en haut d'une nouvelle page est
   * précisément l'effet voulu.
   */
  let firstPage = true;

  /** Haut du premier texte de la page, en coordonnées du document. */
  function firstTextTop(): number {
    const main = document.querySelector("main");
    if (!main) return Infinity;

    const walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT);
    const range = document.createRange();

    while (walker.nextNode()) {
      const node = walker.currentNode;
      if (!node.textContent?.trim()) continue;

      range.selectNodeContents(node);
      const rect = range.getBoundingClientRect();
      if (rect.height > 0) return rect.top + window.scrollY;
    }

    return Infinity;
  }

  onEachPage((signal) => {
    const header = document.querySelector("header");

    if (!header) return;

    const returnAt = barReturnThreshold(firstTextTop());
    let lastY = window.scrollY;

    const set = (scrolled: boolean) => header.toggleAttribute("data-scrolled", scrolled);

    const update = () => {
      const y = window.scrollY;
      set(nextBarScrolled({ scrolled: header.hasAttribute("data-scrolled"), y, lastY, returnAt }));
      placeTrail();
      lastY = y;
    };

    /*
     * Fil d'Ariane de la barre : recopié du `<template>` du Breadcrumb de la
     * page, puis affiché dès que le fil de la page est passé sous la barre
     * (`trailInBar`, src/lib/nav.ts). Vidé sur une page qui n'en a pas.
     *
     * Le header persiste : en arrivant d'une page où il était affiché, l'ancien
     * fil repart d'abord en fondu, et n'est remplacé qu'une fois invisible. Il
     * ne peut pas revenir entre-temps : tant que la copie n'est pas faite, son
     * placement est suspendu.
     */
    const bar = header.querySelector<HTMLElement>(".header-bar");
    const trail = header.querySelector<HTMLElement>("[data-header-trail]");
    const crumbs = document.querySelector<HTMLElement>("main [data-breadcrumb]");
    const source = document.querySelector<HTMLTemplateElement>("main template[data-trail-source]");
    let filled = false;

    const placeTrail = () => {
      if (!filled) return;

      const inBar =
        crumbs && bar
          ? trailInBar(crumbs.getBoundingClientRect().bottom, bar.getBoundingClientRect().bottom)
          : false;

      header.toggleAttribute("data-trail", inBar);
    };

    const fillTrail = () => {
      trail?.replaceChildren(...(source ? [source.content.cloneNode(true)] : []));
      filled = true;
      placeTrail();
    };

    if (header.hasAttribute("data-trail")) {
      header.removeAttribute("data-trail");
      // La durée du fondu de sortie, dans le style plus haut.
      const timer = window.setTimeout(fillTrail, 150);
      signal.addEventListener("abort", () => window.clearTimeout(timer));
    } else {
      fillTrail();
    }

    // Sans sens de défilement connu (chargement, navigation) : seul le seuil bas compte.
    const sync = () => {
      set(initialBarScrolled(window.scrollY));
      placeTrail();
    };

    if (firstPage) {
      firstPage = false;
      header.setAttribute("data-instant", "");
      sync();
      // Deux images : la première applique l'état, la seconde rend la main
      // aux transitions une fois cet état peint.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => header.removeAttribute("data-instant"));
      });
    } else {
      sync();
    }

    window.addEventListener("scroll", update, { passive: true, signal });
    // Un fil qui passe sur deux lignes, ou une barre qui change de hauteur.
    window.addEventListener("resize", placeTrail, { signal });
  });
</script>

<script>
  import { onEachPage } from "../../lib/enhance";
  /**
   * Menu repliable sous 48rem. Ses liens sont une seconde liste, propre au
   * panneau : voir le balisage, plus haut.
   */
  onEachPage((signal) => {
    const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const menu = document.getElementById("nav-menu");

    if (toggle && menu) {
      const iconOpen = toggle.querySelector(".nav-icon-open");
      const iconClose = toggle.querySelector(".nav-icon-close");

      const setOpen = (open: boolean) => {
        menu.toggleAttribute("data-open", open);
        toggle.setAttribute("aria-expanded", String(open));
        // Libellés rendus par le serveur dans la langue de la page.
        toggle.setAttribute(
          "aria-label",
          (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "",
        );
        iconOpen?.classList.toggle("hidden", open);
        iconClose?.classList.toggle("hidden", !open);
      };

      // `{ signal }` même sur un élément : le header est persisté, ses nœuds
      // survivent à la navigation et les écouteurs s'y accumuleraient.
      toggle.addEventListener(
        "click",
        () => {
          setOpen(!menu.hasAttribute("data-open"));
        },
        { signal },
      );

      // Une ancre ne recharge pas la page : sans ça le menu resterait ouvert.
      for (const link of menu.querySelectorAll("a")) {
        link.addEventListener("click", () => setOpen(false), { signal });
      }

      document.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape" && menu.hasAttribute("data-open")) {
            setOpen(false);
            toggle.focus();
          }
        },
        { signal },
      );

      // Repasser en grand écran laisserait sinon l'état « ouvert » derrière soi.
      // Le seuil du style, en rem lui aussi : il suit la taille de police.
      window.matchMedia("(width >= 48rem)").addEventListener(
        "change",
        (event) => {
          if (event.matches) setOpen(false);
        },
        { signal },
      );
    }
  });
</script>

<script>
  import { onEachPage } from "../../lib/enhance";
  import { activeSectionIndex, readingLine } from "../../lib/nav";
  /**
   * Surligne le lien de la dernière section dont le haut a franchi une ligne de
   * lecture placée au premier tiers de la fenêtre, sous le header collant.
   *
   * « La dernière commencée » plutôt que « celle qui croise la ligne » : entre
   * deux sections, le lien précédent reste allumé au lieu de s'éteindre.
   *
   * Le bas de page est un cas à part : sur un grand écran, la dernière section
   * peut occuper la moitié de la fenêtre sans que son haut ait franchi la ligne
   * de lecture. Puisqu'on ne peut pas défiler plus loin, elle est alors forcée.
   *
   * Le calcul est géométrique plutôt que basé sur IntersectionObserver : celui-ci
   * ne délivre rien tant que l'onglet n'est pas peint, et le choix de la section
   * « la plus visible » est instable quand une section dépasse la hauteur de la
   * fenêtre.
   *
   * Sur une page sans section observable, seul l'`aria-current="page"` rendu par
   * le serveur reste en place — mais encore faut-il effacer d'abord le
   * surlignage de la page précédente : voir plus bas.
   *
   * Chaque section a deux liens, un par liste (barre large et menu replié) : les
   * deux s'allument ensemble, et le menu s'ouvre déjà sur la bonne section.
   */
  onEachPage((signal) => {
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
    ];

    const linksBySection = new Map<string, HTMLAnchorElement[]>();

    for (const link of links) {
      for (const id of (link.dataset.sections ?? "").split(" ").filter(Boolean)) {
        linksBySection.set(id, [...(linksBySection.get(id) ?? []), link]);
      }
    }

    const sections = [...linksBySection.keys()]
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => section !== null);

    /*
     * Repartir d'une ardoise nette à chaque navigation, AVANT de savoir s'il y a
     * quelque chose à observer.
     *
     * Le header porte `transition:persist` : ses nœuds traversent l'échange de
     * page. Un `data-active` posé au défilement de l'accueil survivait donc à
     * l'arrivée sur /projects/, où l'absence de section empêchait toute mise à
     * jour de l'effacer — deux liens se retrouvaient soulignés, celui de la
     * section qu'on venait de quitter et celui de la page où l'on était.
     */
    for (const link of links) {
      delete link.dataset.active;
    }

    if (sections.length > 0) {
      sections.sort((a, b) =>
        a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1,
      );

      const update = () => {
        const atBottom =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 1;

        const index = activeSectionIndex(
          sections.map((section) => section.getBoundingClientRect().top),
          readingLine(window.innerHeight),
          atBottom,
        );

        const active = index >= 0 ? (linksBySection.get(sections[index].id) ?? []) : [];

        for (const link of links) {
          if (active.includes(link)) {
            link.dataset.active = "";
          } else {
            delete link.dataset.active;
          }
        }
      };

      update();
      window.addEventListener("scroll", update, { passive: true, signal });
      window.addEventListener("resize", update, { signal });
    }
  });
</script>

<script>
  import { onEachPage } from "../../lib/enhance";
  import { switchLangPath, type Lang } from "../../lib/i18n";
  import { readingPosition, restoredScrollY, type ReadingPosition } from "../../lib/lang-switch";
  import { wireShineToggle } from "../../lib/shine";
  import { wireThemeToggle, withViewTransition } from "../../lib/theme";

  const motionOk = () => !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /**
   * Interrupteurs du panneau de réglages et du menu replié : voir src/lib/theme.ts et
   * src/lib/shine.ts, où ils sont testés. Le changement de thème se fait dans
   * un fondu enchaîné de toute la page. Les deux réglages sont posés avant le
   * premier rendu par le script en ligne de BaseLayout.
   */
  onEachPage((signal) => {
    const theme = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")];
    const shine = [...document.querySelectorAll<HTMLButtonElement>("[data-shine-toggle]")];

    wireThemeToggle(theme, document.documentElement, () => localStorage, signal, (update) =>
      withViewTransition(document, motionOk(), update),
    );
    wireShineToggle(shine, document.documentElement, () => localStorage, signal);
  });

  /**
   * Cale le panneau sous l'engrenage, bord droit contre bord droit.
   *
   * L'engrenage bouge pendant que le panneau est ouvert : la barre se resserre
   * au défilement (0,8 s de transition au-delà de 72rem), et la fenêtre peut
   * changer de taille. Le panneau le suit donc image par image, tant qu'il est
   * ouvert, et seulement alors.
   */
  onEachPage((signal) => {
    const gear = document.querySelector<HTMLElement>("[data-settings-toggle]");
    const panel = document.getElementById("settings-panel");

    if (!gear || !panel) return;

    let frame = 0;

    /*
     * L'état déplié est en principe implicite avec `popovertarget`, mais tous
     * les navigateurs ne le transmettent pas aux lecteurs d'écran : il est donc
     * posé à la main. Absent du rendu serveur, où il serait faux une fois le
     * panneau ouvert sans script.
     */
    const expand = (open: boolean) => gear.setAttribute("aria-expanded", String(open));

    const place = () => {
      const rect = gear.getBoundingClientRect();
      const right = document.documentElement.clientWidth - rect.right;

      panel.style.top = `${rect.bottom + 8}px`;
      panel.style.right = `${Math.max(right, 16)}px`;
      frame = requestAnimationFrame(place);
    };

    const stop = () => cancelAnimationFrame(frame);

    panel.addEventListener(
      "beforetoggle",
      (event) => {
        const open = (event as ToggleEvent).newState === "open";

        stop();
        expand(open);
        if (open) place();
      },
      { signal },
    );

    // Sous 48rem, l'engrenage disparaît : le panneau ne resterait pas accroché à rien.
    window.matchMedia("(width >= 48rem)").addEventListener(
      "change",
      (event) => {
        if (!event.matches && panel.matches(":popover-open")) panel.hidePopover();
      },
      { signal },
    );

    signal.addEventListener("abort", stop);
    expand(panel.matches(":popover-open"));
    if (panel.matches(":popover-open")) place();
  });

  /*
   * Changer de langue sans perdre sa place : voir src/lib/lang-switch.ts.
   *
   * Le module vit tant que le document vit, navigations comprises : la position
   * notée au clic attend donc ici l'échange de page, sans passer par un stockage.
   */
  let pending: ReadingPosition | null = null;

  /** Défilement maximal de la page courante. */
  const maxScroll = () => document.documentElement.scrollHeight - window.innerHeight;

  /**
   * Garde le lien de langue sur la page courante, et note la position de
   * lecture au clic.
   *
   * Le header persiste d'une page à l'autre dans une même langue : le lien rendu
   * par le serveur viserait sinon toujours l'équivalent de la page d'arrivée.
   */
  onEachPage((signal) => {
    const link = document.querySelector<HTMLAnchorElement>("[data-lang-switch]");
    const target = link?.getAttribute("hreflang") as Lang | null;

    if (!link || !target) return;

    link.href = switchLangPath(window.location.pathname, target);
    link.addEventListener(
      "click",
      () => {
        // Les sections de l'accueil : les seuls repères communs aux deux langues.
        const landmarks = [...document.querySelectorAll<HTMLElement>("main section[id]")].map(
          (section) => ({ id: section.id, top: section.getBoundingClientRect().top }),
        );

        pending = readingPosition(landmarks, window.scrollY, maxScroll());
      },
      { signal },
    );
  });

  /*
   * Sur la page d'arrivée, et seulement après un changement de langue : pas
   * d'animation d'entrée du gabarit, qui ferait rejouer au header et au hero
   * une ouverture de site. Le drapeau est posé sur le document entrant, dont
   * les attributs de `<html>` remplacent ceux de la page quittée.
   *
   * ⚠️ `data-lang-switching`, pas `data-lang-switch` : sous le nom du lien, le
   * drapeau était trouvé avant lui par le `querySelector` ci-dessus, et le lien
   * de la page d'arrivée n'était plus câblé.
   */
  document.addEventListener("astro:before-swap", (event) => {
    if (pending) event.newDocument.documentElement.setAttribute("data-lang-switching", "");
  });

  /*
   * Rétablit la position avant que la nouvelle page ne soit peinte : le fondu
   * du routeur passe ainsi d'un texte à sa traduction, au même endroit.
   *
   * Les blocs déjà à l'écran sont révélés d'office : sans cela, ils
   * rejoueraient leur apparition au défilement comme si on arrivait sur la page.
   * Révélés SANS transition : mesurer leur position leur a déjà donné leur style
   * masqué, et l'attribut seul les ferait remonter en fondu depuis l'opacité 0.
   */
  document.addEventListener("astro:after-swap", () => {
    if (!pending) return;

    const position = pending;
    pending = null;

    const landmark = position.id ? document.getElementById(position.id) : null;
    const landmarkTop = landmark
      ? landmark.getBoundingClientRect().top + window.scrollY
      : undefined;

    window.scrollTo({
      top: restoredScrollY(position, landmarkTop, maxScroll()),
      behavior: "instant",
    });

    const visible = [...document.querySelectorAll<HTMLElement>(".reveal")].filter(
      (block) => block.getBoundingClientRect().top < window.innerHeight,
    );

    for (const block of visible) {
      block.style.transition = "none";
      block.setAttribute("data-revealed", "");
    }

    // Lire une mesure applique le nouvel état ; les transitions reviennent ensuite.
    void document.body.offsetHeight;
    for (const block of visible) block.style.removeProperty("transition");
  });
</script>
