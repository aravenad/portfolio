---
import Container from "../ui/Container.astro";
import { site, socialLinks } from "../../data/site";
import { useTranslations } from "../../data/ui";
import { getLang, localizedUrl } from "../../lib/i18n";

const year = new Date().getFullYear();
const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
const outbound = (href: string) => (href.startsWith("http") ? "noreferrer" : undefined);
// D'un seul tenant : à 320 px, « Mentions légales » se coupait en deux lignes.
// Le retour à la ligne se fait entre les liens (voir plus bas).
const pageLink = "whitespace-nowrap transition hover:text-zinc-200";
---

{/*
  Persisté d'une page à l'autre, mais par langue : changer de langue remplace
  le pied de page au lieu de garder l'ancien texte.

  Le pied de page reste une seule ligne : le plan du site, les mentions
  légales et la déclaration d'accessibilité n'y sont que des liens vers leurs
  pages (src/components/pages).
*/}
<footer transition:persist={`footer-${lang}`} class="page-enter border-t border-zinc-900 py-10" style="--index: 3">
  <Container
    class="flex flex-col items-start justify-between gap-4 text-sm text-zinc-500 sm:flex-row sm:items-center"
  >
    {/*
      Sur téléphone, la ligne ne tient plus : le droit d'auteur d'un côté, les
      liens des pages de l'autre, chacun sur sa ligne. Ces liens vont alors à
      la ligne entre eux, jamais au milieu d'un intitulé, et se séparent par
      un espace plutôt que par des points : un point resterait sinon seul en
      bout de ligne.
    */}
    <p class="flex flex-col gap-1 sm:block">
      <span>© {year} {site.name}. {t.footer.rights}</span>
      <span class="flex flex-wrap gap-x-4 gap-y-1 sm:inline">
        <span aria-hidden="true" class="mx-2 hidden text-zinc-700 sm:inline">·</span>
        <a href={localizedUrl("/sitemap", lang)} class={pageLink}>{t.footer.sitemap}</a>
        <span aria-hidden="true" class="mx-2 hidden text-zinc-700 sm:inline">·</span>
        <a href={localizedUrl("/legal", lang)} class={pageLink}>{t.footer.legal}</a>
        <span aria-hidden="true" class="mx-2 hidden text-zinc-700 sm:inline">·</span>
        <a href={localizedUrl("/accessibility", lang)} class={pageLink}>{t.footer.accessibility}</a>
      </span>
    </p>

    {/* Elle va à la ligne si le texte est agrandi (WCAG 1.4.4) : sinon toute la page défile en largeur. */}
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
      {
        socialLinks.map((link) => (
          <li>
            <a href={link.href} rel={outbound(link.href)} class="transition hover:text-zinc-200">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</footer>

<script>
  /*
   * Le pied de page est conservé d'une page à l'autre (`transition:persist`).
   * Le routeur d'Astro rend alors le focus au lien qu'on vient de suivre, par
   * un `focus()` qui fait défiler jusqu'à lui : on arrivait en bas de la page
   * visitée, après une descente en douceur depuis le haut. Le lien perd son
   * focus juste avant l'échange, et la page d'arrivée reste en haut, comme
   * après un chargement complet.
   *
   * Posé une fois par document, comme les écouteurs de navigation du header :
   * le module ne se réexécute pas d'une page à l'autre.
   */
  document.addEventListener("astro:before-swap", () => {
    const active = document.activeElement;
    if (active instanceof HTMLElement && active.closest("footer")) active.blur();
  });
</script>
