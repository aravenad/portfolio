---
import Container from "../ui/Container.astro";
import { site, socialLinks } from "../../data/site";

const year = new Date().getFullYear();
---

<footer transition:persist class="page-enter border-t border-zinc-900 py-10" style="--index: 3">
  <Container
    class="flex flex-col items-start justify-between gap-4 text-sm text-zinc-500 sm:flex-row sm:items-center"
  >
    <p>© {year} {site.name}. Tous droits réservés.</p>

    <ul class="flex items-center gap-6">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              rel={link.href.startsWith("http") ? "noreferrer" : undefined}
              class="transition hover:text-zinc-200"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</footer>
