---
import Container from "../ui/Container.astro";
import { navLinks, navLinksEn, site, socialLinks } from "../../data/site";
import { useTranslations } from "../../data/ui";
import { publicCv } from "../../lib/cv";
import { getLang, localizedUrl } from "../../lib/i18n";
import { getProjectHref, getProjects } from "../../lib/projects";

const year = new Date().getFullYear();
const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
const sections = lang === "en" ? navLinksEn : navLinks;
const projects = await getProjects(lang);
const cv = publicCv();

/** Titre de groupe du plan : petit, en capitales espacées, discret. */
const groupTitle = "block text-xs font-medium tracking-wider text-zinc-400 uppercase";
const mapLink = "transition hover:text-zinc-100";
const outbound = (href: string) => (href.startsWith("http") ? "noreferrer" : undefined);
---

{/*
  Persisté d'une page à l'autre, mais par langue : changer de langue remplace
  le pied de page au lieu de garder l'ancien texte.

  Le pied de page reste une seule ligne. Le plan du site n'y est qu'un lien :
  il s'ouvre par-dessus la page (`popover`), sans allonger le bas de page.
  L'élément `popover` apporte seul l'ouverture, la fermeture par Échap ou par
  un clic à côté, et l'affichage au-dessus de tout. Ses liens restent dans le
  HTML, donc lus par les moteurs de recherche.
*/}
<footer transition:persist={`footer-${lang}`} class="page-enter border-t border-zinc-900 py-10" style="--index: 3">
  <Container
    class="flex flex-col items-start justify-between gap-4 text-sm text-zinc-500 sm:flex-row sm:items-center"
  >
    {/*
      Sur téléphone, la ligne ne tient plus : le droit d'auteur d'un côté, le
      plan et les mentions légales de l'autre, chacun sur sa ligne. Sans quoi le
      premier point séparateur restait seul en bout de ligne.
    */}
    <p class="flex flex-col gap-1 sm:block">
      <span>© {year} {site.name}. {t.footer.rights}</span>
      <span>
        <span aria-hidden="true" class="mx-2 hidden text-zinc-700 sm:inline">·</span>
        <button type="button" popovertarget="site-map" class="cursor-pointer transition hover:text-zinc-200">
          {t.footer.sitemapLabel}
        </button>
        <span aria-hidden="true" class="mx-2 text-zinc-700">·</span>
        <a href={localizedUrl("/legal", lang)} class="transition hover:text-zinc-200">{t.footer.legal}</a>
      </span>
    </p>

    <ul class="flex items-center gap-6">
      {
        socialLinks.map((link) => (
          <li>
            <a href={link.href} rel={outbound(link.href)} class="transition hover:text-zinc-200">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>

  <nav
    id="site-map"
    popover
    aria-label={t.footer.sitemapLabel}
    class="site-map m-auto max-h-[calc(100svh-2rem)] w-[min(56rem,calc(100%-2rem))] overflow-y-auto rounded-2xl border border-zinc-800 bg-zinc-950/90 p-8 text-sm text-zinc-500 backdrop-blur-xl sm:p-10"
  >
    <div class="flex items-start justify-between gap-6">
      <p class="text-lg font-semibold text-zinc-100">{t.footer.sitemapLabel}</p>
      <button
        type="button"
        popovertarget="site-map"
        popovertargetaction="hide"
        aria-label={t.footer.close}
        class="-m-2 cursor-pointer p-2 text-zinc-500 transition hover:text-zinc-100"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <div class="mt-8 grid gap-10 sm:grid-cols-[1fr_2fr_1fr]">
      <div>
        <a href={localizedUrl("/", lang)} class:list={[groupTitle, "transition hover:text-zinc-100"]}>
          {t.footer.home}
        </a>
        <ul class="mt-4 space-y-2">
          {
            sections.map((link) => (
              <li>
                <a href={localizedUrl(link.href, lang)} class={mapLink}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <a href={localizedUrl("/projects", lang)} class:list={[groupTitle, "transition hover:text-zinc-100"]}>
          {t.footer.projects}
        </a>
        <ul class="mt-4 space-y-2">
          {
            projects.map((project) => (
              <li>
                <a href={getProjectHref(project, lang)} class={mapLink}>{project.data.title}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class={groupTitle}>{t.footer.contact}</p>
        <ul class="mt-4 space-y-2">
          {
            socialLinks.map((link) => (
              <li>
                <a href={link.href} rel={outbound(link.href)} class={mapLink}>{link.label}</a>
              </li>
            ))
          }
          <li>
            <a href={cv.href} download={cv.filename} class={mapLink}>{t.footer.cv}</a>
          </li>
          <li>
            <a href={localizedUrl("/legal", lang)} class={mapLink}>{t.footer.legal}</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</footer>

<script>
  import { onEachPage } from "../../lib/enhance";

  /*
   * Un lien du plan mène à une autre page, ou à une section de celle-ci : le
   * plan se referme. Le pied de page étant persisté, il resterait sinon ouvert
   * par-dessus la page d'arrivée.
   */
  /*
   * Le pied de page est conservé d'une page à l'autre (`transition:persist`).
   * Le routeur d'Astro rend alors le focus au lien qu'on vient de suivre, par
   * un `focus()` qui fait défiler jusqu'à lui : on arrivait en bas de la page
   * visitée, après une descente en douceur depuis le haut. Le lien perd son
   * focus juste avant l'échange, et la page d'arrivée reste en haut, comme
   * après un chargement complet.
   *
   * Posé une fois par document, comme les écouteurs de navigation du header :
   * le module ne se réexécute pas d'une page à l'autre.
   */
  document.addEventListener("astro:before-swap", () => {
    const active = document.activeElement;
    if (active instanceof HTMLElement && active.closest("footer")) active.blur();
  });

  onEachPage((signal) => {
    const map = document.getElementById("site-map");

    map?.addEventListener(
      "click",
      (event) => {
        if ((event.target as Element).closest("a")) map.hidePopover();
      },
      { signal },
    );
  });
</script>
