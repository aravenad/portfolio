---
import { ClientRouter } from "astro:transitions";
/*
 * Matière du fond, 1920 × 3770, encodée en WebP avec perte (qualité 80).
 *
 * Elle l'était en sans perte : 5,2 Mo, soit 319 ms de téléchargement mesurées
 * sur le site déployé. Tant qu'elle n'était pas arrivée, le flou de la barre de
 * navigation n'avait rien à flouter et n'apparaissait qu'en retard.
 *
 * La perte ne se voit pas : le calque est composé en `screen` et fortement
 * masqué, si bien que l'erreur d'encodage, qui atteint 22/255 dans l'image
 * elle-même, retombe à 6/255 au plus sur la page rendue.
 *
 * Régénérer depuis la source (tools/metal-study/, hors dépôt) :
 * sharp(src).webp({ quality: 80, effort: 6 }).toFile("src/assets/chrome-original-hq.webp")
 */
import chromeField from "../assets/chrome-original-hq.webp";
import BackToTop from "../components/ui/BackToTop.astro";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import { site } from "../data/site";
import { url } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const isHomePage = Astro.url.pathname.replace(/\/+$/, "") === url("/").replace(/\/+$/, "");

/** URL absolues : les robots d'aperçu ignorent les chemins relatifs. */
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
/*
 * Nom versionné : LinkedIn met en cache les images d'aperçu par URL et ne
 * retélécharge pas un fichier de même nom. Renommer à chaque refonte de
 * l'image est le seul moyen de forcer leur mise à jour.
 *
 * v5 : la carte reprend la matière photographique du fond. v3 montrait encore
 * le marbrage procédural d'avant, et ne ressemblait plus à l'accueil. La v4,
 * elle, laissait la matière passer derrière le texte : réduite par LinkedIn à
 * ~520px puis réencodée en JPEG, elle paraissait floue. Elle n'a jamais servi
 * ailleurs que dans l'inspecteur et n'est pas conservée. v3 reste dans public/ :
 * les publications déjà partagées continuent de pointer dessus.
 */
const ogImageURL = new URL(url("/og-v5.png"), Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    {/*
      Ce qu'une politique de sécurité du contenu peut faire ici, et rien de plus.

      GitHub Pages ne permet pas de poser d'en-têtes HTTP : il ne reste que la
      balise `<meta>`, qui ignore `frame-ancestors`. Le CSP intégré d'Astro
      (`security.csp`) hacherait les scripts et les styles, mais sa
      documentation exclut explicitement `<ClientRouter />`, dont dépend toute
      la navigation du site. Une directive `script-src` écrite à la main
      devrait alors ouvrir `'unsafe-inline'`, ce qui ne protégerait plus de
      rien.

      Restent trois directives sans risque, qu'aucune page n'utilise et qui
      ferment autant de portes : pas de `<base>` injecté qui détournerait tous
      les liens relatifs, pas de greffon, et aucun formulaire — donc aucun
      envoi de données possible vers l'extérieur.
    */}
    <meta
      http-equiv="content-security-policy"
      content="base-uri 'self'; object-src 'none'; form-action 'none'"
    />

    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta
      property="og:image:alt"
      content="Damien Aravena Bravo — étudiant en BUT Informatique à Grenoble"
    />

    <meta name="twitter:card" content="summary_large_image" />

    {/*
      La matière du fond est déclarée en `background-image` dans global.css : le
      navigateur ne la découvre donc qu'une fois la feuille de style reçue et
      analysée. Mesuré sur le build, en 4G lente : découverte à 377 ms contre
      172 ms pour le CSS — le fond apparaissait visiblement après le texte.

      Ce préchargement la rend visible dès le HTML, en parallèle du CSS.
      L'import en frontmatter est indispensable : c'est lui qui donne l'URL
      empreintée par Vite, qu'un chemin écrit à la main ne peut pas deviner.
    */}
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href={chromeField.src}
      fetchpriority="high"
    />

    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />

    <title>{title}</title>

    {/*
      Transitions de page : la navigation devient un échange de DOM avec fondu,
      au lieu d'un rechargement complet.

      ⚠️ Conséquence à ne pas perdre de vue : les `<script>` des composants ne
      sont plus réexécutés d'une page à l'autre. Tout comportement doit passer
      par `onEachPage()` (src/lib/enhance.ts), sinon il meurt à la deuxième page
      sans rien signaler.
    */}
    <ClientRouter />

    {/*
      Ce script est volontairement en ligne et bloquant : il doit s'exécuter
      AVANT le premier rendu. Posé dans un module différé, les blocs
      s'afficheraient puis disparaîtraient pour se révéler — un clignotement pire
      que l'absence d'animation.

      Le garde-fou compte autant que le drapeau : si le module qui révèle les
      blocs n'arrive jamais (erreur réseau, script bloqué), le drapeau se retire
      tout seul et tout redevient visible. Rien ne doit pouvoir rendre la moitié
      du site invisible de façon permanente.
    */}
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        /*
          `setAttribute` / `hasAttribute` plutôt que `dataset` : une valeur de
          dataset vide est une chaîne vide, donc FAUSSE. Un test `if (!dataset.x)`
          se déclenche alors même quand le drapeau est posé — c'est ce qui faisait
          sortir l'observateur aussitôt et retirer le drapeau à tous les coups.
        */
        const arm = (root) => {
          root.setAttribute("data-reveal-armed", "");

          // Garde-fou : si le module qui révèle les blocs n'arrive jamais, le
          // drapeau se retire seul et tout redevient visible. Sans lui, une
          // erreur de chargement cacherait la moitié du site pour toujours.
          setTimeout(() => {
            if (!document.documentElement.hasAttribute("data-reveal-ready")) {
              document.documentElement.removeAttribute("data-reveal-armed");
            }
          }, 3000);
        };

        arm(document.documentElement);

        /*
          ⚠️ Réarmer à CHAQUE navigation, sur le document ENTRANT.

          L'échange de vue recopie les attributs de `<html>` depuis le document
          entrant : un drapeau posé à l'exécution est donc effacé, et la
          révélation ne fonctionnait que sur la première page visitée. Le poser
          sur `event.newDocument` l'installe avant que la page ne soit peinte —
          `astro:page-load` serait trop tard et ferait clignoter le contenu.
        */
        document.addEventListener("astro:before-swap", (event) => {
          arm(event.newDocument.documentElement);
        });
      }
    </script>
  </head>

  <body data-home={isHomePage} class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
    <div class="flex min-h-screen flex-col">
      <Header />

      <main id="main" class="flex-1">
        <slot />
      </main>

      <Footer />
    </div>

    <BackToTop />

    <script>
      import { onEachPage } from "../lib/enhance";

      /**
       * Met chaque reflet chromé en pause dès qu'il quitte l'écran.
       *
       * L'animation porte sur une `background-position` découpée par le texte :
       * elle n'est pas composée par le GPU et repeint à chaque image. Mesurée
       * sur le build, elle coûte ~9 % du fil principal par élément — et autant
       * une fois sorti de l'écran, puisqu'une animation CSS ne s'arrête pas
       * d'elle-même. Le site en compte six : sans cela, une page laissée ouverte
       * consommerait indéfiniment pour des mots que personne ne regarde.
       *
       * Sous `prefers-reduced-motion`, il n'y a aucune animation à mettre en
       * pause : la propriété est alors posée dans le vide, sans effet ni coût.
       */
      /**
       * Une ancre atteinte depuis une autre page se rejoint en descendant.
       *
       * Sans cela, arriver sur `/#career` depuis la page projets dépose le
       * lecteur au milieu du document sans qu'il ait vu ce qu'il traversait —
       * mesuré, la trajectoire faisait un bond de 1 800 px avant de finir en
       * douceur. On repart donc du haut, puis on descend.
       *
       * Le retour vers le haut est explicitement instantané ; la descente, elle,
       * n'impose aucun `behavior` et suit le `scroll-behavior` de la feuille de
       * style, qui respecte déjà `prefers-reduced-motion`. `scrollIntoView`
       * honore aussi le `scroll-mt-16` des sections, donc le header collant ne
       * recouvre pas le titre visé.
       */
      onEachPage(() => {
        const id = window.location.hash.slice(1);
        const target = id ? document.getElementById(id) : null;

        if (!target) return;

        window.scrollTo({ top: 0, behavior: "instant" });
        requestAnimationFrame(() => target.scrollIntoView());
      });

      /**
       * Révèle les blocs à mesure qu'ils entrent dans la fenêtre.
       */
      onEachPage((signal) => {
        const root = document.documentElement;

        if (!root.hasAttribute("data-reveal-armed")) return;

        const blocks = document.querySelectorAll<HTMLElement>(".reveal");

        // Sans IntersectionObserver, mieux vaut tout montrer que rien.
        if (!("IntersectionObserver" in window)) {
          root.removeAttribute("data-reveal-armed");
          return;
        }

        /*
         * Décalage entre voisins : les trois cartes d'une rangée arrivent l'une
         * après l'autre plutôt qu'en bloc. C'est ce qui fait lire l'effet comme
         * une animation et non comme un contenu qui s'allume.
         *
         * Plafonné : une liste de parcours en compte huit, et 8 x 110 ms de
         * retard sur le dernier se remarquerait comme une lenteur.
         */
        for (const block of blocks) {
          const siblings = [...(block.parentElement?.children ?? [])].filter(
            (child) => child.classList.contains("reveal"),
          );

          block.style.setProperty(
            "--reveal-index",
            String(Math.min(siblings.indexOf(block), 3)),
          );
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;

              (entry.target as HTMLElement).setAttribute("data-revealed", "");
              observer.unobserve(entry.target);
            }
          },
          // Le bloc se révèle une fois franchement entré, pas au ras du bord.
          { rootMargin: "0px 0px -15% 0px" },
        );

        for (const block of blocks) observer.observe(block);

        // Signale au garde-fou que la relève est assurée.
        root.setAttribute("data-reveal-ready", "");
        signal.addEventListener("abort", () => observer.disconnect());
      });

      onEachPage((signal) => {
        const shines = document.querySelectorAll<HTMLElement>(".text-chrome");

        if (shines.length === 0 || !("IntersectionObserver" in window)) return;

        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            (entry.target as HTMLElement).style.animationPlayState =
              entry.isIntersecting ? "running" : "paused";
          }
        });

        for (const shine of shines) observer.observe(shine);

        // L'observateur vise des éléments que l'échange de DOM va détruire.
        signal.addEventListener("abort", () => observer.disconnect());
      });
    </script>
  </body>
</html>
