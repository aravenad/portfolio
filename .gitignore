# réglages locaux de l'assistant (lancement du serveur de dev pour l'aperçu),
# propres à cette machine.
.claude/
# fichiers produits par les sessions Claude (lettres de motivation…) : ils
# portent des données de candidature, sans rapport avec ce dépôt public.
Claude outputs/

# étude de direction artistique du fond métallique : 38 Mo de sources, de
# rendus et de variantes, dont un GIF de comparaison de 19,6 Mo. Atelier, pas
# livrable — seuls les fichiers retenus vivent dans src/assets/.
tools/metal-study/

# Tout ce qui sert aux candidatures, hors du site : kit CV (sources HTML,
# bandeaux, notes), CV exportés, lettres de motivation, analyses d'offres. Ils
# portent le téléphone, l'adresse mail et des disponibilités, que le dépôt
# public ne doit jamais contenir : un commit est définitif, même supprimé. Le
# site n'en garde que l'export public, copié dans public/.
candidatures/

# ancien fond, archivé le 21 septembre 2026 : le commit 7b8785d le contient
# déjà en entier, la copie n'est qu'une aide locale.
tools/background-archive/

# sorties générées : PDF exportés et aperçus de contrôle
output/
tmp/
